# graalgo — root build orchestration
#
# Per project standing order (2026-10-12): `make all` regenerates all
# generated artifacts and runs the test suite. CI
# ([.github/workflows/ci.yml](.github/workflows/ci.yml)) runs `make all`
# and then `git diff --exit-code` — if the build regenerates any tracked
# file differently from what's committed, CI fails.
#
# Phase layout: [phases/phase1](phases/phase1) (language core + gofrontend),
# [phases/phase2](phases/phase2) (scheduler core), [phases/phase3](phases/phase3)
# (sync bindings). Each phase has its own Makefile; this file orchestrates.
#
# CI SCOPE — honest, not aspirational.
#   `make all` = generate + build + check + test-ci:
#     generate  rebuilds the gofrontend binary and overlay.json from sources
#     build     compiles all three phase modules (javac, -Werror)
#     check     placeholder / debug-leftover / netpoller / exclusion-list
#               grep gates + the gofrontend gofmt/vet/tests gate
#     test-ci   fast in-JVM tests (phase1 Truffle smoke tests)
#
# EXCLUDED from per-push CI (documented here and in ci.yml, not forgotten):
#   `make test` — the full differential suite (phase1 graalgo.test.Runner,
#   phase2 SchedTestRunner, phase3 IfaceTestRunner, plus the wave1-3
#   corpus differentials). It takes 30+ minutes and runs in local
#   verification and nightly runs, not per-push. Invoke it explicitly.
#
# KNOWN PRE-EXISTING FAILURE (not introduced by CI): `make check` currently
# fails the phase3 placeholder gate on two TODOs in
# [phases/phase3/src/main/java/graalgo/p3tls/TlsRuntime.java](phases/phase3/src/main/java/graalgo/p3tls/TlsRuntime.java)
# (synthetic crypto/tls markers, commit af0238a). These are owned by the
# x509 lane, which is replacing the synthetic implementation. CI is red on
# this until that lane lands — this is the gate working as designed.

# Generated artifacts and their generators (standing order: every generated
# file committed to the repo must list its generator here; `make all`
# regenerates them and CI fails on drift).
#   - [phases/phase1/frontend/gofrontend](phases/phase1/frontend/gofrontend) +
#     [overlay.json](phases/phase1/frontend/overlay.json): regenerated by
#     `generate` below ([frontend/build.sh](phases/phase1/frontend/build.sh)).
#     Both are gitignored build outputs; the drift gate guards tracked files
#     the build might touch.
GENERATED := phases/phase1/frontend/gofrontend phases/phase1/frontend/overlay.json

.PHONY: all generate build check test-ci test clean

all: generate build check test-ci

# Force-regenerate the gofrontend binary and overlay.json from the
# vendored frontend sources (frontend/*.go + frontend/go overlay).
generate:
	cd phases/phase1/frontend && ./build.sh build

build:
	$(MAKE) -C phases/phase1 main
	$(MAKE) -C phases/phase2 main
	$(MAKE) -C phases/phase3 main

check:
	$(MAKE) -C phases/phase1 check
	$(MAKE) -C phases/phase2 check
	$(MAKE) -C phases/phase3 check

# CI-feasible tests: phase1 Truffle smoke tests (runtime + DSL processor).
# Fast (<2 min) and dependency-free. The full differential corpora are
# `make test` (see header comment).
test-ci: build
	$(MAKE) -C phases/phase1 smoke-test

# Full test suite: all phase differential/test runners. LONG (30+ min);
# for local verification and nightly runs, not per-push CI.
test: build
	$(MAKE) -C phases/phase1 test
	$(MAKE) -C phases/phase2 test
	$(MAKE) -C phases/phase3 test

clean:
	$(MAKE) -C phases/phase1 clean
	$(MAKE) -C phases/phase2 clean
	$(MAKE) -C phases/phase3 clean
