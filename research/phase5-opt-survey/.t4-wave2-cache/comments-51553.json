  {
    "url": "https://api.github.com/repos/golang/go/issues/comments/1063528415",
    "html_url": "https://github.com/golang/go/issues/51553#issuecomment-1063528415",
    "issue_url": "https://api.github.com/repos/golang/go/issues/51553",
    "id": 1063528415,
