{
  "backends": [
    {
      "build": [
        "{GO}/bin/go",
        "build",
        "-o",
        "{BIN}",
        "{SRC}"
      ],
      "env": {
        "GOMAXPROCS": "1",
        "GOTOOLCHAIN": "local"
      },
      "name": "gc-a",
      "run": [
        "{BIN}"
      ],
      "vars": {
        "GO": "${DH_GO}"
      }
    },
    {
      "build": [
        "{GO}/bin/go",
        "build",
        "-o",
        "{BIN}",
        "{SRC}"
      ],
      "env": {
        "GOMAXPROCS": "1",
        "GOTOOLCHAIN": "local"
      },
      "name": "gc-b",
      "run": [
        "{BIN}"
      ],
      "vars": {
        "GO": "${DH_GO}"
      }
    },
    {
      "build": [
        "{GRAALGO_RUN}",
        "--check",
        "{SRC}"
      ],
      "env": {
        "GOMAXPROCS": "1",
        "GOTOOLCHAIN": "local"
      },
      "name": "graalgo",
      "run": [
        "{GRAALGO_RUN}",
        "{SRC}"
      ],
      "vars": {
        "GRAALGO_RUN": "${PHASE1_DIR}/graalgo-run"
      },
      "stderrFilters": [
        "^WARNING: A terminally deprecated method in sun\\.misc\\.Unsafe has been called$",
        "^WARNING: sun\\.misc\\.Unsafe::.*$",
        "^WARNING: Please consider reporting this to the maintainers.*$",
        "^Java HotSpot\\(TM\\) 64-Bit Server VM warning:.*$",
        "^   \\S*hsperfdata\\S*$",
        "^Try using the -Djava\\.io\\.tmpdir= option to select an alternate temp location\\.$"
      ]
    }
  ],
  "exclusions": [],
  "timeoutSec": 30
}
