{
  "backends": [
    {
      "build": [
        "{GO}/bin/go",
        "build",
        "-o",
        "{BIN}",
        "{SRC}"
      ],
      "env": {
        "GOMAXPROCS": "1",
        "GOTOOLCHAIN": "local"
      },
      "name": "gc-a",
      "run": [
        "{BIN}"
      ],
      "vars": {
        "GO": "${DH_GO}"
      }
    },
    {
      "build": [
        "{GO}/bin/go",
        "build",
        "-o",
        "{BIN}",
        "{SRC}"
      ],
      "env": {
        "GOMAXPROCS": "1",
        "GOTOOLCHAIN": "local"
      },
      "name": "gc-b",
      "run": [
        "{BIN}"
      ],
      "vars": {
        "GO": "${DH_GO}"
      }
    },
    {
      "build": [
        "{GRAALGO_RUN}",
        "--check",
        "{SRC}"
      ],
      "env": {
        "GOMAXPROCS": "1",
        "GOTOOLCHAIN": "local"
      },
      "name": "graalgo",
      "run": [
        "{GRAALGO_RUN}",
        "{SRC}"
      ],
      "stderrFilters": [
        "^WARNING: A terminally deprecated method in sun\\.misc\\.Unsafe has been called$",
        "^WARNING: sun\\.misc\\.Unsafe::.*$",
        "^WARNING: Please consider reporting this to the maintainers.*$"
      ],
      "vars": {
        "GRAALGO_RUN": "${PHASE3_DIR}/graalgo-sync-run"
      }
    }
  ],
  "exclusions": [
    {
      "program": "10_closures",
      "reason": "backend-specific: call via index expr ops[0](5) not in frontend/v1 scope (WS D)"
    },
    {
      "program": "19_sort",
      "reason": "backend-specific: sort.Slice needs reflect (not in scope)"
    },
    {
      "program": "27_panic_trace",
      "reason": "other: panic trace format differs (main.level3(...) vs level3()); fidelity gap"
    },
    {
      "program": "40_method_values",
      "reason": "backend-specific: method values not in scope"
    },
    {
      "program": "42_json",
      "reason": "backend-specific: encoding/json.Marshal not in synthetic json scope"
    }
  ],
  "timeoutSec": 30
}
