--- a/phases/phase1/src/main/java/graalgo/frontend/NilCheckNode.java
+++ b/phases/phase1/src/main/java/graalgo/frontend/NilCheckNode.java
@@ -34,7 +34,13 @@ public final class NilCheckNode extends GoExprNode {
 
     @Override
     public boolean executeBoolean(VirtualFrame frame) {
-        boolean isNull = child.executeObject(frame) == null;
+        // P3-M8: long/int-kind children (unsafe.Pointer handles) test the
