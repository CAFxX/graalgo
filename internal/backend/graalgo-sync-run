#!/usr/bin/env bash
# graalgo-sync-run — Phase 3 launcher wrapper.
#
# Invoked by the diffharness (build: graalgo-sync-run --check {SRC};
# run: graalgo-sync-run {SRC}). Requires `make main` to have been run in
# phases/phase1, phases/phase2, and phases/phase3 (out/classes must exist);
# this script never builds.
#
# This is the product launcher (P3SyncMain): unlike the phase-1 graalgo-run,
# it supports channels/select and the full stdlib surface, so the smoke
# corpus runs without exclusions.
set -euo pipefail
HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
GRAALVM_HOME="${GRAALVM_HOME:-$HOME/tools/graalvm-jdk-25}"
P1="$HERE/../phase1"
P2="$HERE/../phase2"
P3="$HERE"
CP="$P3/out/classes:$P2/out/classes:$P1/out/classes"
for jar in "$P1"/lib/*.jar; do
  CP="$CP:$jar"
done
# -Djava.io.tmpdir: keep the JVM off /tmp (a full /tmp silently yields
# empty output with exit 0 — methodology review finding, cf. wave runners).
exec "$GRAALVM_HOME/bin/java" --enable-native-access=ALL-UNNAMED -Xss32m \
  -Djava.io.tmpdir="${TMPDIR:-/tmp}" \
  -cp "$CP" graalgo.p3sync.launcher.P3SyncMain "$@"
