#!/usr/bin/env bash
# graalgo-bundle-run — the runner of programs linked by graalgo-tool
# (docs/arch/toolexec-design.md §4.2): the launcher stub at the front of a
# linked executable execs this script with the executable's path followed by
# the program's arguments; graalgo.launcher.BundleMain loads the bundle from
# the executable and runs it on the new node package (graalgo.go, toolexec
# W4) through the polyglot API.
#
# Requires `make build`. GRAALGO_JAVA_OPTS: extra JVM flags (word-split),
# e.g. "-Xmx2g -XX:ActiveProcessorCount=4" on shared hosts.
# GRAALGO_TRUFFLE_CLASSES: where the truffle module's classes are (default
# truffle/out/classes): the test gates pass a jar of the same classes, which
# a class-data-sharing archive can map (test/lib/jvmcds.sh; CDS refuses a
# non-empty directory on the class path).
set -euo pipefail
HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
GRAALVM_HOME="${GRAALVM_HOME:-$HOME/tools/graalvm-jdk-25}"
CP="${GRAALGO_TRUFFLE_CLASSES:-$HERE/truffle/out/classes}"
for jar in "$HERE"/truffle/lib/*.jar; do
  CP="$CP:$jar"
done
# Flags as in graalgo-sync-run (see there for the reasons), plus
# -XX:G1HeapRegionSize=32m: a goroutine that is preempted deep in a recursion
# has its virtual-thread stack frozen into one heap chunk; with G1's default
# region size (1 MB under -Xmx2g) a chunk over half a region is refused
# ("StackOverflowError: Humongous stack chunk") at a depth gc handles easily.
#
# -Djava.lang.invoke.MethodHandle.CUSTOMIZE_THRESHOLD=-1 (no LambdaForm
# customization): Truffle's virtual-thread mount hook
# (HotSpotThreadLocalHandshake.setPendingFlagForVirtualThread) reads the
# carrier thread through a MethodHandle (polyglot JDKSupport
# .currentCarrierThread). The JDK customizes a handle on its 128th inexact
# invocation (MethodHandle.customize); when that invocation is the mount
# hook's, the customization re-enters the mount hook, which invokes the same
# handle, which is still uncustomized and customizes again: the goroutine's
# virtual thread ends 128 hooks deep inside MethodHandle.customize, mounted,
# using no CPU, and the program hangs (measured 12 hangs in 60 runs of
# test/m1r/programs/atomic_contention.go on 4 CPUs, 0 in 45 with the flag;
# docs/arch/toolexec-design.md §13 finding 4). The flag removes the trigger;
# the defect is the runtime's and the flag goes when a GraalVM pin has it
# fixed.
# `--batch MANIFEST RESULTS`: the test gates' batch runner instead
# (graalgo.launcher.BundleBatchMain, test/lib/batchrun.sh): many linked
# programs in fresh contexts of this one JVM, same flags.
MAIN=graalgo.launcher.BundleMain
if [ "${1:-}" = --batch ]; then
  MAIN=graalgo.launcher.BundleBatchMain
  shift
fi
# shellcheck disable=SC2086
exec "$GRAALVM_HOME/bin/java" --enable-native-access=ALL-UNNAMED --add-exports java.base/jdk.internal.vm=ALL-UNNAMED -Xss32m -XX:-UsePerfData -XX:G1HeapRegionSize=32m \
  -Djava.lang.invoke.MethodHandle.CUSTOMIZE_THRESHOLD=-1 ${GRAALGO_JAVA_OPTS:-} \
  --sun-misc-unsafe-memory-access=allow \
  -Djava.io.tmpdir="${TMPDIR:-/tmp}" \
  -cp "$CP" "$MAIN" "$@"
