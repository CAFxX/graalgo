#!/usr/bin/env bash
# graalgo-run — backend launcher wrapper.
#
# Invoked directly by the diffharness (build: graalgo-run --check {SRC};
# run: graalgo-run {SRC}). Requires `make build` to have been run first at
# the repo root (internal/backend/{truffle,interop}/out/classes must exist);
# this script never builds.
#
# interop/out/classes is included so the main launcher can resolve the sync
# wire nodes (SyncNewNode) needed by real stdlib packages such as fmt (which
# uses sync.Pool).
set -euo pipefail
HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
GRAALVM_HOME="${GRAALVM_HOME:-$HOME/tools/graalvm-jdk-25}"
# Prefer the repo's gofrontend binary (internal/frontend/gofrontend, built
# by `make generate`) unless GRAALGO_GOFRONTEND overrides it.
if [ -z "${GRAALGO_GOFRONTEND:-}" ] && [ -x "$HERE/../frontend/gofrontend" ]; then
  export GRAALGO_GOFRONTEND="$HERE/../frontend/gofrontend"
fi
CP="$HERE/truffle/out/classes:$HERE/interop/out/classes"
for jar in "$HERE"/truffle/lib/*.jar; do
  CP="$CP:$jar"
done
# -XX:-UsePerfData: no hsperfdata mmap file. With it on, concurrent JVMs
# sharing a temp dir intermittently print "Java HotSpot(TM) 64-Bit Server VM
# warning: ... hsperfdata ... locked" on stderr — JVM noise that broke
# byte-identity with gc (flaky snapshot-check). Suppressed at the source.
# GRAALGO_JAVA_OPTS: extra JVM flags (word-split), e.g. resource caps for
# test runs on shared hosts: "-Xmx2g -XX:ActiveProcessorCount=4".
# shellcheck disable=SC2086
exec "$GRAALVM_HOME/bin/java" --enable-native-access=ALL-UNNAMED -Xss32m -XX:-UsePerfData ${GRAALGO_JAVA_OPTS:-} \
  --sun-misc-unsafe-memory-access=allow \
  -cp "$CP" graalgo.launcher.Main "$@"
# --sun-misc-unsafe-memory-access=allow: suppress the JDK 25 "terminally
# deprecated sun.misc.Unsafe" warnings on stderr (Truffle uses Unsafe
# internally); they would otherwise pollute the program's stderr.
# -Xss32m: see the truffle module Makefile's M5 stance note (guest recursion
# burns host stack; the panic corpus's 10000-deep unwind needs ~13-16m).
