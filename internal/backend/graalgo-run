#!/usr/bin/env bash
# graalgo-run — backend launcher wrapper.
#
# Invoked directly by the diffharness (build: graalgo-run --check {SRC};
# run: graalgo-run {SRC}). Requires `make build` to have been run first at
# the repo root (internal/backend/{truffle,runtime}/out/classes must exist);
# this script never builds.
#
# Classpath order is load-bearing: runtime/out/classes comes FIRST so the
# runtime module's same-FQN replacements shadow the truffle module's frozen
# phase-1 stubs.
set -euo pipefail
HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
GRAALVM_HOME="${GRAALVM_HOME:-$HOME/tools/graalvm-jdk-25}"
# BRIDGE (frontend lane): the gofrontend binary still builds at
# phases/phase1/frontend until the frontend code-move lane relocates it to
# internal/frontend/ (which the launcher's ToolPaths walk-up then finds on
# its own). Until then, point the launcher at the current location.
if [ -z "${GRAALGO_GOFRONTEND:-}" ] && [ -x "$HERE/../frontend/gofrontend" ]; then
  export GRAALGO_GOFRONTEND="$HERE/../frontend/gofrontend"
fi
CP="$HERE/runtime/out/classes:$HERE/truffle/out/classes"
for jar in "$HERE"/truffle/lib/*.jar; do
  CP="$CP:$jar"
done
exec "$GRAALVM_HOME/bin/java" --enable-native-access=ALL-UNNAMED -Xss32m \
  -cp "$CP" graalgo.launcher.Main "$@"
# -Xss32m: see the truffle module Makefile's M5 stance note (guest recursion
# burns host stack; the panic corpus's 10000-deep unwind needs ~13-16m).
