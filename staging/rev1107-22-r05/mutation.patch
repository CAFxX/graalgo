+// jarCP returns the colon-joined jars of a backend module's lib/ dir.
+// Zero jars is an error: a suite run against an empty classpath would
+// fail everywhere and report nothing useful.
+func jarCP(moduleDir string) (string, error) {
+	jars, err := filepath.Glob(filepath.Join(moduleDir, "lib", "*.jar"))
+	if err != nil {
+		return "", err
+	}
+	if len(jars) == 0 {
+		return "", fmt.Errorf("no jars in %s (is this a backend module dir?)", filepath.Join(moduleDir, "lib"))
+	}
+	return strings.Join(jars, ":"), nil
+}
