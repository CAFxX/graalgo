+// resolveGofrontend finds the gofrontend binary the suite will use, the
+// same way the launcher does (internal/backend/runtime/.../ToolPaths):
+// GRAALGO_GOFRONTEND when it names an executable, else
+// <repo>/internal/frontend/gofrontend.
+func resolveGofrontend(repo string) (string, error) {
+	if v := os.Getenv("GRAALGO_GOFRONTEND"); v != "" {
+		if isExecutable(v) {
+			return v, nil
+		}
+		return "", fmt.Errorf("GRAALGO_GOFRONTEND=%q is not executable", v)
+	}
+	p := filepath.Join(repo, "internal", "frontend", "gofrontend")
+	if isExecutable(p) {
+		return p, nil
+	}
+	return "", fmt.Errorf("gofrontend binary not found: build it with ./build.sh build in internal/frontend (or set GRAALGO_GOFRONTEND)")
+}
+
+// checkPrerequisites fails fast when the built tree the suite needs is not
+// there, naming the command that builds each missing piece. Without this,
+// a missing class tree makes every mutant ERROR (or worse, makes the
+// baseline fail in a way that reads as a killed mutant).
+func checkPrerequisites(repo string, layout backendLayout, layoutErr error) error {
+	if layoutErr != nil {
+		return layoutErr
+	}
+	for _, dir := range []struct{ path, build string }{
+		{layout.RuntimeClasses, "make -C internal/backend/truffle main (builds the runtime joint round)"},
+		{layout.MainClasses, "make -C internal/backend/truffle main (builds the truffle stubs)"},
+		{layout.TestClasses, "make -C internal/backend/truffle out/test-classes/.built (builds the test classes)"},
+	} {
+		if fi, err := os.Stat(dir.path); err != nil || !fi.IsDir() {
+			return fmt.Errorf("missing class tree %s: build it with %s", dir.path, dir.build)
+		}
+	}
+	runnerClass := filepath.Join(layout.TestClasses, "graalgo", "test", "Runner.class")
+	if _, err := os.Stat(runnerClass); err != nil {
+		return fmt.Errorf("missing test runner %s: build it with make -C internal/backend/truffle out/test-classes/.built", runnerClass)
+	}
+	if _, err := resolveGofrontend(repo); err != nil {
+		return err
+	}
+	for _, bin := range []string{javaBin(), javaRunBin(), goBin()} {
+		if !isExecutable(bin) {
+			return fmt.Errorf("toolchain binary not executable: %s", bin)
+		}
+	}
+	return nil
+}
