+// testRepoRoot returns the graalgo repo root for tests that need the live
+// tree (layout roots, spec validation). In the repo, main_test.go lives at
+// <repo>/tools/mutation/, so the root is three levels up. When the module
+// is staged outside the repo (e.g. /tmp during a quota-blocked lane),
+// set MUTATION_TEST_REPO to the repo path instead.
+func testRepoRoot(t *testing.T) string {
+	t.Helper()
+	if v := os.Getenv("MUTATION_TEST_REPO"); v != "" {
+		return v
+	}
+	_, file, _, ok := runtime.Caller(0)
+	if !ok {
+		t.Fatal("runtime.Caller failed")
+	}
+	return filepath.Clean(filepath.Join(filepath.Dir(file), "..", "..", ".."))
+}
+
+func testModuleDir(t *testing.T) string {
+	t.Helper()
