+// mutantOverlay returns the Go overlay JSON for building the frontend with
+// one file replaced: build.sh's vendoring map plus repoFile -> mutPath.
+func mutantOverlay(frontendDir, repoFile, mutPath, goBin string) ([]byte, error) {
