+// fakeGoBin writes a stub "go" binary that answers `env GOROOT` with
+// goroot, for tests of the vendoring-overlay generation.
+func fakeGoBin(t *testing.T, goroot string) string {
+	t.Helper()
+	dir := t.TempDir()
+	p := filepath.Join(dir, "go")
+	script := "#!/bin/sh\nif [ \"$1\" = env ] && [ \"$2\" = GOROOT ]; then echo " + goroot + "; fi\n"
+	if err := os.WriteFile(p, []byte(script), 0755); err != nil {
+		t.Fatal(err)
+	}
+	return p
+}
