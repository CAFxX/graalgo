+func TestSuiteCommandMirrorsMakefile(t *testing.T) {
+	repo := testRepoRoot(t)
+	layout, err := truffleLayout(repo)
+	if err != nil {
+		t.Fatalf("truffleLayout: %v", err)
+	}
+	tmpDir := "/tmp/mutation-test-tmp"
+	cmd := suiteCommand(repo, layout, tmpDir, suiteOpts{Overlay: "/tmp/ov", Gofrontend: "/tmp/gf"})
+	if cmd.Dir != layout.Dir {
+		t.Errorf("suite must run in the truffle module dir, got %s", cmd.Dir)
+	}
+	args := strings.Join(cmd.Args, " ")
+	for _, want := range []string{
+		"--enable-native-access=ALL-UNNAMED", "-Xss32m",
+		"-Djava.io.tmpdir=" + tmpDir,
+		"-Dgraalgo.repo.dir=" + repo,
+		layout.Runner,
+	} {
+		if !strings.Contains(args, want) {
+			t.Errorf("suite command missing %q: %s", want, args)
+		}
+	}
+	// Classpath order: overlay : test : runtime : stubs : jars.
+	cpIdx := -1
+	for i, a := range cmd.Args {
+		if a == "-cp" {
+			cpIdx = i + 1
+		}
+	}
+	if cpIdx < 0 || cpIdx >= len(cmd.Args) {
+		t.Fatalf("suite command has no -cp: %v", cmd.Args)
+	}
+	cp := cmd.Args[cpIdx]
+	wantCP := "/tmp/ov:" + layout.TestClasses + ":" + layout.RuntimeClasses + ":" + layout.MainClasses + ":" + layout.Jars
+	if cp != wantCP {
+		t.Errorf("suite classpath wrong:\n got %s\nwant %s", cp, wantCP)
+	}
+	env := strings.Join(cmd.Env, "\n")
+	for _, want := range []string{"TMPDIR=" + tmpDir, "GOTMPDIR=" + tmpDir, "GRAALGO_GOFRONTEND=/tmp/gf"} {
+		if !strings.Contains(env, want) {
+			t.Errorf("suite env missing %q", want)
+		}
+	}
+}
