+			t.Fatal(err)
+		}
+		if err := os.WriteFile(p, []byte("package x\n"), 0644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	fakeGo := fakeGoBin(t, "/fake/goroot")
+
+	// No overlay.json present: generate by walking.
+	m, err := vendoringReplace(fe, fakeGo)
+	if err != nil {
+		t.Fatalf("vendoringReplace (generate): %v", err)
+	}
+	if got := m[filepath.Join("/fake/goroot", "src", "go", "a", "b.go")]; got != filepath.Join(fe, "go", "a", "b.go") {
+		t.Errorf("generated map wrong for a/b.go: %q (map: %v)", got, m)
+	}
+	if got := m[filepath.Join("/fake/goroot", "src", "go", "c.go")]; got != filepath.Join(fe, "go", "c.go") {
+		t.Errorf("generated map wrong for c.go: %q", got)
+	}
+
+	// overlay.json present and fresh: read verbatim.
+	overlay := map[string]map[string]string{"Replace": {
+		"/fake/goroot/src/go/a/b.go": filepath.Join(fe, "go", "a", "b.go"),
+		"/fake/goroot/src/go/c.go":   filepath.Join(fe, "go", "c.go"),
+	}}
+	data, err := json.Marshal(overlay)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(fe, "overlay.json"), data, 0644); err != nil {
+		t.Fatal(err)
+	}
+	m2, err := vendoringReplace(fe, fakeGo)
+	if err != nil {
+		t.Fatalf("vendoringReplace (read): %v", err)
+	}
+	if len(m2) != 2 {
+		t.Errorf("read map should have exactly the 2 overlay entries, got %v", m2)
+	}
+
+	// overlay.json stale (one value missing): fall back to generation.
+	stale := map[string]map[string]string{"Replace": {
+		"/fake/goroot/src/go/a/b.go": filepath.Join(fe, "go", "gone.go"),
+	}}
+	data, err = json.Marshal(stale)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(fe, "overlay.json"), data, 0644); err != nil {
+		t.Fatal(err)
+	}
+	m3, err := vendoringReplace(fe, fakeGo)
+	if err != nil {
+		t.Fatalf("vendoringReplace (stale fallback): %v", err)
+	}
+	if len(m3) != 2 {
+		t.Errorf("stale overlay must fall back to the generated 2-entry map, got %v", m3)
+	}
+}
