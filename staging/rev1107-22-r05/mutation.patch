+// backendLayout is the live backend build layout for one module, derived
+// from the repo tree (not hardcoded): the class trees the module's tests
+// run against and the jar set they link. The classpath order below mirrors
+// internal/backend/truffle/Makefile's test target:
+//
+//	out/test-classes : runtime/out/classes : truffle/out/classes : lib/*.jar
+//
+// (runtime first among main classes: the runtime module's joint round
+// compiles the truffle module's non-stub sources, so runtime/out/classes
+// holds the real NodeFactory etc.; truffle/out/classes holds only the 8
+// frozen stubs, which the runtime replacements shadow.)
+type backendLayout struct {
+	Module         string // "truffle"
+	Dir            string // <repo>/internal/backend/truffle
+	RuntimeDir     string // <repo>/internal/backend/runtime
+	MainClasses    string // <truffle>/out/classes
+	TestClasses    string // <truffle>/out/test-classes
+	RuntimeClasses string // <runtime>/out/classes
+	Jars           string // colon-joined <truffle>/lib/*.jar
+	Runner         string // "graalgo.test.Runner"
+}
+
+// truffleLayout builds the layout for the truffle module. It errors only
+// when the jar set is empty (a missing lib/ means the checkout is not a
+// usable backend tree); missing class trees are a prerequisite failure,
+// reported by checkPrerequisites, not here — so that -dry-run works on an
+// unbuilt tree.
+func truffleLayout(repo string) (backendLayout, error) {
+	truffleDir := filepath.Join(repo, "internal", "backend", "truffle")
+	runtimeDir := filepath.Join(repo, "internal", "backend", "runtime")
+	jars, err := jarCP(truffleDir)
+	if err != nil {
+		return backendLayout{}, err
+	}
+	return backendLayout{
+		Module:         "truffle",
+		Dir:            truffleDir,
+		RuntimeDir:     runtimeDir,
+		MainClasses:    filepath.Join(truffleDir, "out", "classes"),
+		TestClasses:    filepath.Join(truffleDir, "out", "test-classes"),
+		RuntimeClasses: filepath.Join(runtimeDir, "out", "classes"),
+		Jars:           jars,
+		Runner:         "graalgo.test.Runner",
+	}, nil
+}
+
+// compileClasspath is the -cp for compiling one mutated truffle-module
+// source file: the joint-round classes (which hold the file's
+// dependencies) plus the stub classes plus the jars.
+func (l backendLayout) compileClasspath() string {
+	return l.RuntimeClasses + ":" + l.MainClasses + ":" + l.Jars
+}
+
+// testClasspath is the -cp for running the suite, with an optional overlay
+// directory of replacement classes first (shadowing the built classes).
+func (l backendLayout) testClasspath(overlay string) string {
+	cp := ""
+	if overlay != "" {
+		cp = overlay + ":"
+	}
+	return cp + l.TestClasses + ":" + l.RuntimeClasses + ":" + l.MainClasses + ":" + l.Jars
 }
 
