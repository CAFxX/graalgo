+func TestMutantOverlayMerges(t *testing.T) {
+	fe := filepath.Join(t.TempDir(), "frontend")
+	p := filepath.Join(fe, "go", "x.go")
+	if err := os.MkdirAll(filepath.Dir(p), 0755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(p, []byte("package x\n"), 0644); err != nil {
+		t.Fatal(err)
+	}
+	fakeGo := fakeGoBin(t, "/fake/goroot")
+	repoFile := filepath.Join(fe, "export.go")
+	mutPath := filepath.Join(t.TempDir(), "mutated-export.go")
+	data, err := mutantOverlay(fe, repoFile, mutPath, fakeGo)
+	if err != nil {
+		t.Fatalf("mutantOverlay: %v", err)
+	}
+	var overlay struct {
+		Replace map[string]string `json:"Replace"`
+	}
+	if err := json.Unmarshal(data, &overlay); err != nil {
+		t.Fatalf("mutant overlay is not valid JSON: %v", err)
+	}
+	if overlay.Replace[repoFile] != mutPath {
+		t.Errorf("mutant entry missing: %v", overlay.Replace)
+	}
+	if len(overlay.Replace) < 2 {
+		t.Errorf("vendoring entries missing from merged overlay: %v", overlay.Replace)
+	}
+}
