+
+// vendoringReplace returns the GOROOT -> vendored-file map that
+// internal/frontend/build.sh generates (it maps GOROOT's src/go/*.go to
+// the module's vendored ./go/*.go so the frontend builds against the
+// pinned sources, not the toolchain's). It prefers build.sh's own
+// overlay.json when that file is present and every entry still resolves;
+// otherwise it regenerates the map by walking ./go, using the same
+// algorithm build.sh embeds.
+func vendoringReplace(frontendDir, goBin string) (map[string]string, error) {
+	if m, ok := readVendoringOverlay(frontendDir); ok {
+		return m, nil
+	}
+	out, err := exec.Command(goBin, "env", "GOROOT").Output()
+	if err != nil {
+		return nil, fmt.Errorf("go env GOROOT: %v", err)
+	}
+	goroot := strings.TrimSpace(string(out))
+	if goroot == "" {
+		return nil, fmt.Errorf("go env GOROOT returned empty")
+	}
+	replace := map[string]string{}
+	vendDir := filepath.Join(frontendDir, "go")
+	err = filepath.Walk(vendDir, func(path string, info os.FileInfo, err error) error {
+		if err != nil {
+			return err
+		}
+		if info.IsDir() || !strings.HasSuffix(path, ".go") {
+			return nil
+		}
+		rel, err := filepath.Rel(vendDir, path)
+		if err != nil {
+			return err
+		}
+		replace[filepath.Join(goroot, "src", "go", rel)] = path
+		return nil
 	})
+	if err != nil {
+		return nil, err
+	}
+	if len(replace) == 0 {
+		return nil, fmt.Errorf("no vendored go/*.go files under %s", vendDir)
+	}
+	return replace, nil
 }
 
