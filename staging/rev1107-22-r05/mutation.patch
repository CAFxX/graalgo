+// validateMutants rejects a spec whose files do not resolve inside the repo
+// or whose old strings are absent, before anything runs. A mutant file is
+// repo-relative by contract; absolute paths and ".." escapes are rejected
+// rather than read outside the repo.
+func validateMutants(mutants []Mutant, repo string) []error {
+	var errs []error
+	for _, m := range mutants {
+		if m.ID == "" {
+			errs = append(errs, fmt.Errorf("mutant with empty id"))
+			continue
+		}
+		if filepath.IsAbs(m.File) || strings.Contains(m.File, "..") {
+			errs = append(errs, fmt.Errorf("%s: file %q must be repo-relative without ..", m.ID, m.File))
+			continue
+		}
+		srcPath := filepath.Join(repo, m.File)
+		orig, err := os.ReadFile(srcPath)
+		if err != nil {
+			errs = append(errs, fmt.Errorf("%s: file %q: %v", m.ID, m.File, err))
+			continue
+		}
+		if !strings.Contains(string(orig), m.Old) {
+			errs = append(errs, fmt.Errorf("%s: old string not found in %q", m.ID, m.File))
+		}
+		if m.Lang != "java" && m.Lang != "go" {
+			errs = append(errs, fmt.Errorf("%s: unknown lang %q (want java or go)", m.ID, m.Lang))
+		}
+	}
+	return errs
+}
