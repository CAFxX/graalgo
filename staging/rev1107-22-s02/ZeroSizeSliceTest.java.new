package graalgo.runtime;

import graalgo.values.GoKind;
import graalgo.values.GoSlice;
import graalgo.values.GoStructDescriptor;
import java.util.Arrays;
import java.util.List;

/**
 * bug-037: appending to a zero-size-element slice crashed with
 * {@code IllegalArgumentException: slice bounds out of range}.
 *
 * <p>The zero-size path in {@link Intrinsics#growslice} built a
 * {@link GoSlice} with a 0-length backing array but {@code len=cap=newLen>0},
 * violating GoSlice's bounds invariant. The fix allocates a real backing
 * (sized geometrically, reported cap exactly newLen per gc) and reuses it
 * across appends.
 *
 * <p>Each test would have thrown before the fix (demonstrably capable of
 * failing); all assert gc-parity observable behavior.
 *
 * <p>S-02 (review-2026-11-07-07): the zero-size path also skipped copying
 * old elements for STRUCT elements — a struct reports
 * {@code elemSizeBytes == 0} by design, and only the ARRAY case (bug-042)
 * fail-fasted. The guard tests below pin the STRUCT fail-fast (non-empty
 * struct, or unverifiable null descriptor, with size 0 must throw) and its
 * precision (genuinely zero-size structs must still take the fast path).
 */
public final class ZeroSizeSliceTest {

    private static final GoStructDescriptor EMPTY_DESC =
            new GoStructDescriptor("Empty", List.of());

    /** struct { x int64 } — ABI size 8, so never a zero-size element. */
    private static final GoStructDescriptor NONEMPTY_DESC =
            GoStructDescriptor.layout("NonEmpty", List.of("x"), List.of(GoKind.INT64));

    /** struct { e struct{} } — ABI size 0, genuinely zero-size. */
    private static final GoStructDescriptor NESTED_EMPTY_DESC =
            GoStructDescriptor.layout("NestedEmpty",
                    List.of("e"), List.of(GoKind.STRUCT),
                    List.of(-1), Arrays.asList((GoKind) null),
                    Arrays.asList((GoStructDescriptor) null), Arrays.asList(EMPTY_DESC));

    /** struct { a [0]int64 } — ABI size 0, genuinely zero-size. */
    private static final GoStructDescriptor ZERO_ARRAY_DESC =
            GoStructDescriptor.layout("ZeroArray",
                    List.of("a"), List.of(GoKind.ARRAY), List.of(0), List.of(GoKind.INT64));

    private static void check(boolean cond, String msg) {
        if (!cond) {
            throw new AssertionError(msg);
        }
    }

    /** Runs {@code r}, expecting {@code IllegalArgumentException}; fails the test otherwise. */
    private static void checkThrowsIAE(Runnable r, String msg) {
        try {
            r.run();
        } catch (IllegalArgumentException expected) {
            return;
        }
        throw new AssertionError(msg + ": expected IllegalArgumentException, none thrown");
    }

    /** Growing from nil: len=1 cap=1, no crash (the original repro). */
    public void testGrowFromNil() {
        GoSlice s = Intrinsics.growslice(null, GoKind.STRUCT, EMPTY_DESC, 1, 0, false);
        check(s.len() == 1, "len: expected 1 got " + s.len());
        check(s.cap() == 1, "cap: expected 1 (gc parity) got " + s.cap());
    }

    /** gc reports cap == newLen exactly for zero-size growth (never doubled). */
    public void testCapEqualsNewLen() {
        GoSlice s = null;
        for (int i = 1; i <= 10; i++) {
            s = Intrinsics.growslice(s, GoKind.STRUCT, EMPTY_DESC, i, 0, false);
            check(s.len() == i, "len: expected " + i + " got " + s.len());
            check(s.cap() == i, "cap: expected " + i + " (gc parity) got " + s.cap());
        }
    }

    /** Growth from a non-zero cap (make + append): no crash, exact cap. */
    public void testGrowFromMake() {
        GoSlice s = Intrinsics.makeslice(GoKind.STRUCT, EMPTY_DESC, 2, 2);
        check(s.len() == 2 && s.cap() == 2, "make: expected 2/2");
        GoSlice grown = Intrinsics.growslice(s, GoKind.STRUCT, EMPTY_DESC, 3, 0, false);
        check(grown.len() == 3, "len: expected 3 got " + grown.len());
        check(grown.cap() == 3, "cap: expected 3 (gc parity) got " + grown.cap());
    }

    /** Multi-append in one growslice call: no crash, exact cap. */
    public void testMultiAppend() {
        GoSlice s = Intrinsics.growslice(null, GoKind.STRUCT, EMPTY_DESC, 3, 0, false);
        check(s.len() == 3, "len: expected 3 got " + s.len());
        check(s.cap() == 3, "cap: expected 3 (gc parity) got " + s.cap());
    }

    /** Repeated appends reuse the backing (amortized O(1), not O(n^2)). */
    public void testRepeatedAppendsFast() {
        GoSlice s = null;
        long start = System.nanoTime();
        for (int i = 1; i <= 20000; i++) {
            s = Intrinsics.growslice(s, GoKind.STRUCT, EMPTY_DESC, i, 0, false);
        }
        long ms = (System.nanoTime() - start) / 1_000_000;
        check(s.len() == 20000, "len: expected 20000 got " + s.len());
        check(s.cap() == 20000, "cap: expected 20000 got " + s.cap());
        // 20k appends must be fast; the pre-fix-perf path (fresh geometric
        // alloc + full zero-init per append) took minutes.
        check(ms < 5000, "20k appends took " + ms + "ms (expected < 5000ms)");
    }

    // ------------------------------------------------------------------
    // S-02: STRUCT guard on the zero-size path (mirrors the bug-042 ARRAY
    // guard). Each negative test FAILS before the fix (growslice returns a
    // slice, silently dropping old elements) and PASSES after it (fail-fast).
    // ------------------------------------------------------------------

    /**
     * The data-loss repro: growing a slice of non-empty structs with a
     * caller-supplied size of 0 must fail fast instead of returning a fresh
     * backing with the old elements dropped.
     */
    public void testNonEmptyStructZeroSizeFailsFast() {
        GoSlice s = Intrinsics.makeslice(GoKind.STRUCT, NONEMPTY_DESC, 2, 2);
        checkThrowsIAE(() -> {
            Intrinsics.growslice(s, GoKind.STRUCT, NONEMPTY_DESC, 3, 0, false);
        }, "growslice non-empty struct with elemSizeBytes=0");
    }

    /** Same guard from nil: no old elements are needed to trigger it. */
    public void testNonEmptyStructZeroSizeFailsFastFromNil() {
        checkThrowsIAE(() -> {
            Intrinsics.growslice(null, GoKind.STRUCT, NONEMPTY_DESC, 1, 0, false);
        }, "growslice non-empty struct from nil with elemSizeBytes=0");
    }

    /**
     * A null descriptor cannot be verified as zero-size, so it fails fast
     * too — via the 6-arg call and via the 3-arg convenience overload,
     * which passes a null descriptor with elemSizeBytes(STRUCT) == 0.
     */
    public void testStructNullDescZeroSizeFailsFast() {
        checkThrowsIAE(() -> {
            Intrinsics.growslice(null, GoKind.STRUCT, null, 1, 0, false);
        }, "growslice STRUCT null desc with elemSizeBytes=0");
        checkThrowsIAE(() -> {
            Intrinsics.growslice(null, GoKind.STRUCT, 1);
        }, "growslice 3-arg overload STRUCT with elemSizeBytes=0");
    }

    /** Guard precision: struct{ e struct{} } is genuinely zero-size (0 bytes). */
    public void testZeroSizeNestedStructStillFastPath() {
        check(Intrinsics.structSizeBytes(NESTED_EMPTY_DESC) == 0,
                "nested-empty struct size: expected 0");
        GoSlice s = Intrinsics.growslice(null, GoKind.STRUCT, NESTED_EMPTY_DESC, 3, 0, false);
        check(s.len() == 3, "len: expected 3 got " + s.len());
        check(s.cap() == 3, "cap: expected 3 (gc parity) got " + s.cap());
    }

    /** Guard precision: struct{ a [0]int64 } is genuinely zero-size (0 bytes). */
    public void testZeroArrayFieldStructStillFastPath() {
        check(Intrinsics.structSizeBytes(ZERO_ARRAY_DESC) == 0,
                "zero-array struct size: expected 0");
        GoSlice s = Intrinsics.growslice(null, GoKind.STRUCT, ZERO_ARRAY_DESC, 3, 0, false);
        check(s.len() == 3, "len: expected 3 got " + s.len());
        check(s.cap() == 3, "cap: expected 3 (gc parity) got " + s.cap());
    }

    /**
     * Positive control: growing a non-empty-struct slice with its correct
     * ABI size copies the old elements (same GoStruct instances, fresh
     * backing). Passes before and after the fix; guards the fix against
     * breaking the normal path.
     */
    public void testNonEmptyStructGrowsWithCopy() {
        GoSlice s = Intrinsics.makeslice(GoKind.STRUCT, NONEMPTY_DESC, 2, 2);
        GoSlice grown = Intrinsics.growslice(s, GoKind.STRUCT, NONEMPTY_DESC, 3, 8, false);
        check(grown.len() == 3, "len: expected 3 got " + grown.len());
        check(grown.cap() >= 3, "cap: expected >= 3 got " + grown.cap());
        check(grown.array() != s.array(), "grown slice must have a fresh backing array");
        check(((Object[]) grown.array())[0] == ((Object[]) s.array())[0],
                "old element 0 must be copied (same instance)");
        check(((Object[]) grown.array())[1] == ((Object[]) s.array())[1],
                "old element 1 must be copied (same instance)");
    }

    /**
     * Pins the bug-042 ARRAY guard (no test covered it): an ARRAY element
     * with elemSizeBytes=0 must fail fast. Passes before and after the fix.
     */
    public void testArrayZeroSizeFailsFast() {
        checkThrowsIAE(() -> {
            Intrinsics.growslice(null, GoKind.ARRAY, null, 1, 0, false);
        }, "growslice ARRAY with elemSizeBytes=0");
    }
}
