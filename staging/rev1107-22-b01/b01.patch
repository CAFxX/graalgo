+func serverConfig() *tls.Config {
+	cert, err := tls.X509KeyPair([]byte(srvPEM), []byte(srvKeyPEM))
+	if err != nil {
+		panic("X509KeyPair: " + err.Error())
+	}
+	return &tls.Config{
+		Certificates: []tls.Certificate{cert},
+		MinVersion:   tls.VersionTLS12,
+		MaxVersion:   tls.VersionTLS12,
+	}
+}
+
+func clientConfig() *tls.Config {
+	caBlock, _ := pem.Decode([]byte(caPEM))
+	ca, err := x509.ParseCertificate(caBlock.Bytes)
+	if err != nil {
+		panic("parse ca: " + err.Error())
+	}
+	roots := x509.NewCertPool()
+	roots.AddCert(ca)
+	return &tls.Config{
+		RootCAs:    roots,
+		ServerName: "localhost",
+		MinVersion: tls.VersionTLS12,
+		MaxVersion: tls.VersionTLS12,
+	}
+}
+
+// corruptConn is a net.Conn that, once armed, flips the last byte of the
+// first Read chunk longer than a TLS record header (5 bytes). The flip
+// lands inside record ciphertext, so the peer SSLEngine's AEAD check
+// fails on that record. Reads before arming pass through untouched.
+type corruptConn struct {
+	net.Conn
+	mu        sync.Mutex
+	armed     bool
+	corrupted bool
+}
+
+func (c *corruptConn) arm() {
+	c.mu.Lock()
+	c.armed = true
+	c.mu.Unlock()
+}
+
+func (c *corruptConn) Read(b []byte) (int, error) {
+	n, err := c.Conn.Read(b)
+	if n > 5 {
+		c.mu.Lock()
+		if c.armed && !c.corrupted {
+			b[n-1] ^= 0xFF
+			c.corrupted = true
+		}
+		c.mu.Unlock()
+	}
+	return n, err
+}
+
+func TestCorruptRecordReadReturnsError(t *testing.T) {
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatalf("net.Listen: %v", err)
+	}
+	defer ln.Close()
+	ccCh := make(chan *corruptConn, 1)
+	hsDone := make(chan error, 1)
+	readRes := make(chan error, 1)
+	go func() {
+		raw, err := ln.Accept()
+		if err != nil {
+			hsDone <- err
+			readRes <- err
+			return
+		}
+		cc := &corruptConn{Conn: raw}
+		ccCh <- cc
+		srv := tls.Server(cc, serverConfig())
+		defer srv.Close()
+		if err := srv.Handshake(); err != nil {
+			hsDone <- err
+			readRes <- err
+			return
+		}
+		hsDone <- nil
+		buf := make([]byte, 64)
+		_, err = srv.Read(buf)
+		readRes <- err
+	}()
+	conn, err := net.Dial("tcp", ln.Addr().String())
+	if err != nil {
+		t.Fatalf("net.Dial: %v", err)
+	}
+	defer conn.Close()
+	tlsConn := tls.Client(conn, clientConfig())
+	if err := tlsConn.Handshake(); err != nil {
+		t.Fatalf("client Handshake() = %v, want nil", err)
+	}
+	cc := <-ccCh
+	if err := <-hsDone; err != nil {
+		t.Fatalf("server Handshake() = %v, want nil", err)
+	}
+	// Both handshakes are fully done and the server goroutine is blocked
+	// in Read, so the next bytes it reads are application data: arming
+	// now can only corrupt the "hello" record, never a handshake flight.
+	// The corruptor inspects `armed` when its Read returns, and the
+	// client writes only after this arm, so the ordering is deterministic.
+	cc.arm()
+	if _, err := tlsConn.Write([]byte("hello")); err != nil {
+		t.Fatalf("client Write() = %v, want nil", err)
+	}
+	err = <-readRes
+	if err == nil {
+		t.Fatalf("server Read() = nil, want unwrap error (corrupt record)")
+	}
+	if errors.Is(err, io.EOF) {
+		t.Fatalf("server Read() = io.EOF, want non-EOF error (B-01: corrupt record reported as clean EOF)")
+	}
+	if !strings.Contains(err.Error(), "unwrap failed") {
+		t.Fatalf("server Read() = %v, want error containing %q", err, "unwrap failed")
+	}
+}
+
+func TestCleanCloseReadReturnsEOF(t *testing.T) {
+	ln, err := tls.Listen("tcp", "127.0.0.1:0", serverConfig())
+	if err != nil {
+		t.Fatalf("tls.Listen: %v", err)
+	}
+	defer ln.Close()
+	hsDone := make(chan error, 1)
+	readRes := make(chan error, 1)
+	go func() {
+		raw, err := ln.Accept()
+		if err != nil {
+			hsDone <- err
+			readRes <- err
+			return
+		}
+		srv := tls.Server(raw, serverConfig())
+		defer srv.Close()
+		if err := srv.Handshake(); err != nil {
+			hsDone <- err
+			readRes <- err
+			return
+		}
+		hsDone <- nil
+		buf := make([]byte, 64)
+		_, err = srv.Read(buf)
+		readRes <- err
+	}()
+	conn, err := net.Dial("tcp", ln.Addr().String())
+	if err != nil {
+		t.Fatalf("net.Dial: %v", err)
+	}
+	tlsConn := tls.Client(conn, clientConfig())
+	if err := tlsConn.Handshake(); err != nil {
+		t.Fatalf("client Handshake() = %v, want nil", err)
+	}
+	if err := <-hsDone; err != nil {
+		t.Fatalf("server Handshake() = %v, want nil", err)
+	}
+	// Close the client: it sends close_notify, then the TCP FIN. The
+	// server's next Read must see the clean close as io.EOF — the fix
+	// must not turn clean closes into errors.
+	if err := tlsConn.Close(); err != nil {
+		t.Fatalf("client Close() = %v, want nil", err)
+	}
+	if err := <-readRes; !errors.Is(err, io.EOF) {
+		t.Fatalf("server Read() = %v, want io.EOF (clean close)", err)
+	}
+}
