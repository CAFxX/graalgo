index 0000000..2b9c297
--- /dev/null
+++ b/internal/backend/interop/src/test/java/graalgo/p3tls/TlsUnwrapErrorTest.java
@@ -0,0 +1,109 @@
+package graalgo.p3tls;
+
+import java.nio.charset.StandardCharsets;
+import java.util.Arrays;
+
+import graalgo.values.GoSlice;
+import graalgo.values.GoString;
+
+/**
+ * Unit tests for the B-01 unwrap error channel ({@link TlsRuntime#unwrap}
+ * + {@link TlsRuntime#unwrapError}): a null unwrap() return is ambiguous
+ * (clean close vs. failure), and unwrapError() is what tells them apart.
+ *
+ * <p>Priming matters: a fresh client engine is in NEED_WRAP, and in that
+ * state SSLEngine.unwrap() ignores inbound bytes entirely (OK, 0 consumed,
+ * 0 produced — verified against GraalVM JDK 25.0.4). The engine only
+ * parses records once it is in NEED_UNWRAP, i.e. after beginHandshake()
+ * + wrap() have produced the ClientHello. Feeding garbage to an unprimed
+ * engine returns an empty non-null slice and records no error — so a test
+ * that skips the priming step cannot reproduce B-01 at all.
+ *
+ * <p>The clean-close leg (close_notify -> null unwrap + null error) is NOT
+ * covered here: a close_notify received before the handshake completes
+ * throws SSLProtocolException ("Received close_notify during handshake"),
+ * so a genuine clean close is only observable post-handshake, which needs
+ * a server certificate this test does not have. That leg is covered by
+ * the Go regression test test/regression/tls-unwrap-error (real certs,
+ * real close_notify, asserts io.EOF is still returned).
+ */
+public final class TlsUnwrapErrorTest {
+    private static GoSlice slice(byte[] b) {
+        return new GoSlice(b, 0, b.length, b.length);
+    }
+
+    private static GoSlice emptySlice() {
+        return new GoSlice(new byte[0], 0, 0, 0);
+    }
+
+    private static long clientEngine() {
+        return TlsRuntime.newClientEngine(GoString.EMPTY, Long.valueOf(0),
+                Long.valueOf(0), Long.valueOf(0), emptySlice());
+    }
+
+    private static String errString(Object r) {
+        if (r == null) {
+            return null;
+        }
+        GoSlice s = (GoSlice) r;
+        byte[] arr = (byte[]) s.array();
+        return new String(arr, s.offset(), s.len(), StandardCharsets.UTF_8);
+    }
+
+    private static void check(boolean cond, String msg) {
+        if (!cond) {
+            throw new AssertionError(msg);
+        }
+    }
+
+    /** A corrupt record must yield null unwrap + a non-null recorded error. */
+    public void testCorruptRecordReportsError() {
+        long h = clientEngine();
+        try {
+            check(TlsRuntime.beginHandshake(Long.valueOf(h)) == 0,
+                    "beginHandshake failed");
+            // Prime the engine to NEED_UNWRAP: produce the ClientHello.
+            Object flight = TlsRuntime.wrap(Long.valueOf(h), emptySlice());
+            check(flight != null, "wrap produced null (no ClientHello)");
+
+            byte[] garbage = new byte[32];
+            Arrays.fill(garbage, (byte) 0xFF);
+            Object out = TlsRuntime.unwrap(Long.valueOf(h), slice(garbage));
+            check(out == null,
+                    "unwrap(corrupt record) = non-null, want null");
+            String err = errString(TlsRuntime.unwrapError(Long.valueOf(h)));
+            check(err != null,
+                    "unwrapError() = null after corrupt record (B-01: "
+                    + "failure indistinguishable from clean close)");
+            check(err.contains("Unrecognized SSL message"),
+                    "unwrapError() = " + err
+                    + ", want it to contain 'Unrecognized SSL message'");
+        } finally {
+            TlsRuntime.close(Long.valueOf(h));
+        }
+        // No cross-engine contamination: a fresh engine reports no error.
+        long h2 = clientEngine();
+        try {
+            check(errString(TlsRuntime.unwrapError(Long.valueOf(h2))) == null,
+                    "fresh engine reports a stale unwrap error");
+        } finally {
+            TlsRuntime.close(Long.valueOf(h2));
+        }
+    }
+
+    /** No error is recorded before any unwrap call, or after a clean one. */
+    public void testNoErrorBeforeAnyUnwrap() {
+        long h = clientEngine();
+        try {
+            check(errString(TlsRuntime.unwrapError(Long.valueOf(h))) == null,
+                    "fresh engine reports an error before any unwrap");
+            Object out = TlsRuntime.unwrap(Long.valueOf(h), emptySlice());
+            check(out != null,
+                    "unwrap(empty input) = null, want empty non-null slice");
+            check(errString(TlsRuntime.unwrapError(Long.valueOf(h))) == null,
+                    "error recorded after a successful (empty) unwrap");
+        } finally {
+            TlsRuntime.close(Long.valueOf(h));
+        }
+    }
+}
