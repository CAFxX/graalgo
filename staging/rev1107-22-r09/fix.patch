 }
+
+// TestDefaultPathsPointAtLiveTree: the default manifest/pin paths must
+// resolve inside the live tools/stdlib-fork tree (R-09). The old defaults
+// pointed at phases/phase3/stdlib-fork, which no longer exists, so a
+// default invocation of `vendor`/`verify` wrote into (or read from) a
+// resurrected dead path instead of the live manifest/pin.
+func TestDefaultPathsPointAtLiveTree(t *testing.T) {
+	// Tests run with CWD = tools/stdlib-vendor, two levels below the root.
+	repo, err := filepath.Abs(filepath.Join("..", ".."))
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Sanity: this really is the repo root, and the live files are there.
+	for _, rel := range []string{
+		filepath.Join("tools", "stdlib-fork", "vendor-manifest.json"),
+		filepath.Join("tools", "stdlib-fork", "pinned-version.txt"),
+	} {
+		if _, err := os.Stat(filepath.Join(repo, rel)); err != nil {
+			t.Fatalf("live file %q not found under repo root %q: %v", rel, repo, err)
+		}
+	}
+	wantManifest := filepath.Join(repo, "tools", "stdlib-fork", "vendor-manifest.json")
+	if got := defaultManifestPath(repo); got != wantManifest {
+		t.Fatalf("defaultManifestPath(%q) = %q, want %q", repo, got, wantManifest)
+	}
+	wantPin := filepath.Join(repo, "tools", "stdlib-fork", "pinned-version.txt")
+	if got := defaultPinPath(repo); got != wantPin {
+		t.Fatalf("defaultPinPath(%q) = %q, want %q", repo, got, wantPin)
+	}
+	// The defaults must point at files that exist in the live tree.
+	if _, err := os.Stat(defaultManifestPath(repo)); err != nil {
+		t.Fatalf("default manifest path does not exist: %v", err)
+	}
+	if _, err := os.Stat(defaultPinPath(repo)); err != nil {
+		t.Fatalf("default pin path does not exist: %v", err)
+	}
+	// The user-facing help must not state the dead default either.
+	if strings.Contains(usageText, "phases/phase3/stdlib-fork") {
+		t.Fatalf("usageText still states the dead default path phases/phase3/stdlib-fork")
+	}
+}
