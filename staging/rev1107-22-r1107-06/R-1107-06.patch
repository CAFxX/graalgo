+package main
+
+// R-1107-06 (REVIEW-2026-11-07-07, re-verified REVIEW-2026-11-07-22):
+// gc rejects bodyless generic functions outright — verified against
+// go1.27.1 (~/tools/go/bin/go):
+//   - bodyless generic func, with or without //go:linkname:
+//     "generic function is missing function body"
+//   - bodyless method on a generic type, with or without directive:
+//     "missing function body"
+//   - bodied generic func with //go:linkname: link-time
+//     "symbol <name> redeclared"
+// There is no gc-valid program containing this construct (zero generic
+// linknames in the whole go1.27.1 stdlib; the only bodyless generic
+// funcs are builtin max/min, which never reach the exporter; zero
+// bodyless methods on generic types in stdlib and in synth_*.go), so
+// graalgo must reject it with gc's error — not with a milestone-scoped
+// "not in M4 scope" message implying a future milestone will implement
+// it, and not by silently skipping the declaration.
+//
+// RED finding (verified 2026-11-07): the type checker already rejects
+// bodyless generic FUNCS with gc's exact error, so the live gap is
+// narrower than the review stated: a bodyless METHOD on a generic type
+// is silently skipped (templates are skipped before export), and
+// export.go's "not in M4 scope" guard is unreachable dead code (both
+// exportFuncDecl callers skip templates first). The fix rejects
+// bodyless templates at the skip points with gc's error and relabels
+// the dead guard to the same gc-faithful error.
+
+import (
+	"strings"
+	"testing"
+)
+
+// TestLinknameGenericFuncRejected: a bodyless generic func carrying
+// //go:linkname is rejected with gc's "missing function body" error,
+// even when it is never called. (Pinned as a regression test: the type
+// checker already rejects this; the assertion is that the error is
+// gc's wording, not a stale "M4 scope" label.)
+func TestLinknameGenericFuncRejected(t *testing.T) {
+	src := `package main
+
+import _ "unsafe"
+
+//go:linkname genericAdd main.genericAddImpl
+func genericAdd[T int | int64](a, b T) T
+
+func main() {}
+`
+	_, err := ExportFile(writeSyncProg(t, src))
+	if err == nil {
+		t.Fatalf("ExportFile accepted bodyless generic func with //go:linkname; gc rejects it (missing function body)")
+	}
+	if !strings.Contains(err.Error(), "generic function is missing function body") {
+		t.Errorf("wrong error for bodyless generic func with //go:linkname: %v", err)
+	}
+	if strings.Contains(err.Error(), "M4 scope") {
+		t.Errorf("error still cites stale M4 scope: %v", err)
+	}
+}
+
+// TestBodylessGenericFuncWithoutLinknameRejected: the same rejection
+// applies without any directive. The old message falsely claimed a
+// //go:linkname was present (a default symbol is synthesized for plain
+// bodyless funcs), so this case pins the gc-faithful wording too.
+func TestBodylessGenericFuncWithoutLinknameRejected(t *testing.T) {
+	src := `package main
+
+func genericPlain[T int | int64](a, b T) T
+
+func main() {}
+`
+	_, err := ExportFile(writeSyncProg(t, src))
+	if err == nil {
+		t.Fatalf("ExportFile accepted bodyless generic func without //go:linkname; gc rejects it (missing function body)")
+	}
+	if !strings.Contains(err.Error(), "generic function is missing function body") {
+		t.Errorf("wrong error for bodyless generic func without //go:linkname: %v", err)
+	}
+	if strings.Contains(err.Error(), "M4 scope") {
+		t.Errorf("error still cites stale M4 scope: %v", err)
+	}
+}
+
+// TestLinknameGenericMethodRejected: a bodyless method on a generic
+// type is rejected with gc's "missing function body" error. This is
+// the live gap: the type checker does not reject it (the check applies
+// to functions with their own type params, not to methods whose
+// genericity comes from the receiver), and the exporter silently
+// skipped the template.
+func TestLinknameGenericMethodRejected(t *testing.T) {
+	src := `package main
+
+type Box[T any] struct{ v T }
+
+func (b Box[T]) Get() T
+
+func main() {}
+`
+	_, err := ExportFile(writeSyncProg(t, src))
+	if err == nil {
+		t.Fatalf("ExportFile accepted bodyless method on generic type; gc rejects it (missing function body)")
+	}
+	if !strings.Contains(err.Error(), "missing function body") {
+		t.Errorf("wrong error for bodyless method on generic type: %v", err)
+	}
+	if strings.Contains(err.Error(), "M4 scope") {
+		t.Errorf("error still cites stale M4 scope: %v", err)
+	}
+}
+
+// TestLinknameGenericFuncCalledRejected: calling a bodyless generic
+// func must report the declaration error, not the instantiation's
+// "func %s without body" error — gc rejects the declaration itself,
+// whether or not it is called.
+func TestLinknameGenericFuncCalledRejected(t *testing.T) {
+	src := `package main
+
+import (
+	"fmt"
+	_ "unsafe"
+)
+
+//go:linkname genericAdd main.genericAddImpl
+func genericAdd[T int | int64](a, b T) T
+
+func main() {
+	fmt.Println(genericAdd[int](1, 2))
+}
+`
+	_, err := ExportFile(writeSyncProg(t, src))
+	if err == nil {
+		t.Fatalf("ExportFile accepted a call to a bodyless generic func; gc rejects it (missing function body)")
+	}
+	if !strings.Contains(err.Error(), "generic function is missing function body") {
+		t.Errorf("wrong error for a call to a bodyless generic func: %v", err)
+	}
+}
