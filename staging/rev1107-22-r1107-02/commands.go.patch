+// checkPackages runs the frontend --check gate once per package
+// directory over that directory's non-test files. It returns true if
+// any package failed the check. All packages are attempted even after
+// a failure, so one bad package does not hide another's diagnostics.
+//
+// Grouping is by directory because Go puts one package per directory;
+// files passed explicitly (possibly from several directories) are
+// grouped the same way. Within a group, files are de-duplicated so a
+// file named twice is checked once instead of failing on duplicate
+// declarations.
+func checkPackages(root string, files []string) bool {
+	groups := make(map[string][]string)
+	seen := make(map[string]bool)
+	var order []string
+	for _, f := range files {
+		if strings.HasSuffix(f, "_test.go") {
+			continue
+		}
+		if seen[f] {
+			continue
+		}
+		seen[f] = true
+		dir := filepath.Dir(f)
+		if _, ok := groups[dir]; !ok {
+			order = append(order, dir)
+		}
+		groups[dir] = append(groups[dir], f)
+	}
+	failed := false
+	for _, dir := range order {
+		pkgFiles := groups[dir]
+		if code := graalgoRun(root, append([]string{"--check"}, pkgFiles...)); code != 0 {
+			failed = true
+		}
+	}
+	return failed
+}
