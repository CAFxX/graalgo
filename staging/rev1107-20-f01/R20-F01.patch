+++ b/internal/frontend/runtime_nonstdlib_test.go
@@ -0,0 +1,72 @@
+package main
+
+// Regression test for R20-F01 (REVIEW-2026-11-07-20): the exporter's
+// `runtime.*` interception must discriminate on the resolved package
+// PATH, not the package NAME. A non-stdlib package named "runtime"
+// (here: example.com/rev1107-20-f01/runtime, served from a temp GOPATH)
+// defining Version/NumCPU/Gosched/Goexit must compile through the
+// general call path — never the stdlib-runtime wire nodes, and never
+// the Goexit "did not resolve to the overlay package" scope error.
+//
+// RED on unpatched code: runtime.Version lowers to a "runtimeversion"
+// node, NumCPU to "runtimenumcpu", defer/go Gosched to "runtimegosched",
+// and Goexit to the goexit marker — all four assertions fail.
+// GREEN after the fix: none of those nodes appear and ExportFile
+// succeeds; the calls lower to ordinary "call" nodes via exportFuncCall.
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestNonStdlibRuntimePackageNotIntercepted(t *testing.T) {
+	gopath := t.TempDir()
+	fakeRuntime := filepath.Join(gopath, "src", "example.com", "rev1107-20-f01", "runtime")
+	if err := os.MkdirAll(fakeRuntime, 0755); err != nil {
+		t.Fatal(err)
+	}
+	fakeSrc := `package runtime
+
+// A non-stdlib package named "runtime": must never be intercepted as
+// stdlib runtime (R20-F01).
+
+func Version() string { return "fake-1.0" }
+func NumCPU() int     { return 42 }
+func Gosched()        {}
+func Goexit()         {}
+`
+	if err := os.WriteFile(filepath.Join(fakeRuntime, "runtime.go"), []byte(fakeSrc), 0644); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("GOPATH", gopath)
+
+	src := `package main
+
+import runtime "example.com/rev1107-20-f01/runtime"
+
+func main() {
+	v := runtime.Version()
+	n := runtime.NumCPU()
+	_, _ = v, n
+	defer runtime.Gosched()
+	go runtime.Gosched()
+	runtime.Goexit()
+}
+`
+	out, err := ExportFile(writeSyncProg(t, src))
+	if err != nil {
+		t.Fatalf("ExportFile with non-stdlib runtime package: %v", err)
+	}
+	for _, forbidden := range []string{
+		`"kind": "runtimeversion"`,
+		`"kind": "runtimenumcpu"`,
+		`"kind": "runtimegosched"`,
+		`"goexit": true`,
+	} {
+		if strings.Contains(out, forbidden) {
+			t.Errorf("exported JSON contains %s: non-stdlib runtime call was intercepted as stdlib runtime", forbidden)
+		}
+	}
+}
