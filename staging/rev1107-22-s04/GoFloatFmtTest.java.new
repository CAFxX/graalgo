package graalgo.runtime;

/**
 * Direct unit tests for {@link GoFloatFmt} (REVIEW-2026-11-07-07 S-04 /
 * REVIEW-2026-11-07-22 S-04): the hand-rolled shortest-digits port had no
 * direct tests — only indirect differential-corpus coverage, if a corpus
 * program happened to print a float.
 *
 * <p>Every expected string in this file was computed by gc
 * ({@code strconv.FormatFloat}/{@code strconv.FormatComplex}, go1.27.1,
 * {@code ~/tools/go}) from the IEEE bit pattern of the input — never by
 * running the code under test. To regenerate, feed the bit patterns below
 * through {@code strconv.FormatFloat}/{@code strconv.FormatComplex} with
 * the same verb/precision/bitSize; the generator program that produced
 * these vectors is preserved with the lane's review evidence. A test that
 * copied the implementation's outputs would be tautological.
 *
 * <p>One branch is deliberately unpinned: the even-tie-break inside
 * {@code shortestSubnormalParts} (closest, then even last digit) cannot
 * fire on any input — an exact tie would need the subnormal's exact value
 * to sit exactly halfway between two adjacent k-digit decimals, which
 * requires 5^(k-1-e) to divide a (2m+1) with m &lt; 10^k (k &le; 17 for
 * float64, &le; 9 for float32); no such tie exists. Corroborated by an
 * instrumented scan of subnormal bit patterns 1..5000 (both sizes) plus
 * structured large subnormals: zero ties. The branch stays as
 * defense-in-depth matching Go's stated tie rule.
 *
 * <p>Coverage: shortest {@code %g} (float64 + float32) including subnormals
 * (5e-324, 9.88e-324, and the float32 1.4e-45 family) and the subnormal
 * tie-break path, the {@code %g} e/f boundary (exp -4/-5 and exp &gt;=
 * eprec), fixed-precision {@code %e}/{@code %f} including half-to-even
 * rounding (0.125 -&gt; "0.12", 2.5 -&gt; "2", 3.5 -&gt; "4"), values that
 * round to zero (1e-300 {@code %f}), rounding carries (999999.5 {@code %f}
 * prec 0 -&gt; "1000000"), specials (NaN, &plusmn;Inf, &plusmn;0) at every
 * verb, hex float {@code %x}/{@code %X} (prec -1..20, incl. the prec-15
 * rounding edge), binary {@code %b}, and complex formatting
 * (complex64/complex128, incl. subnormal and NaN/Inf components).
 */
public final class GoFloatFmtTest {

    private static void assertEquals(String expected, String actual, String msg) {
        if (!expected.equals(actual)) {
            throw new AssertionError(msg + " expected=" + expected + " actual=" + actual);
        }
    }

    private static void check(long bits, char fmt, int prec, int bitSize, String expected) {
        String actual = GoFloatFmt.formatFloat(Double.longBitsToDouble(bits), fmt, prec, bitSize);
        assertEquals(expected, actual,
                "formatFloat(0x" + Long.toHexString(bits) + ", '" + fmt + "', " + prec + ", " + bitSize + ")");
    }

    private static void check32(int bits, char fmt, int prec, String expected) {
        String actual = GoFloatFmt.formatFloat((double) Float.intBitsToFloat(bits), fmt, prec, 32);
        assertEquals(expected, actual,
                "formatFloat32(0x" + Integer.toHexString(bits) + ", '" + fmt + "', " + prec + ")");
    }

    private static void checkHex(long bits, char fmt, int prec, int bitSize, String expected) {
        String actual = GoFloatFmt.formatHex(Double.longBitsToDouble(bits), fmt, prec, bitSize);
        assertEquals(expected, actual,
                "formatHex(0x" + Long.toHexString(bits) + ", '" + fmt + "', " + prec + ", " + bitSize + ")");
    }

    private static void checkHex32(int bits, char fmt, int prec, String expected) {
        String actual = GoFloatFmt.formatHex((double) Float.intBitsToFloat(bits), fmt, prec, 32);
        assertEquals(expected, actual,
                "formatHex32(0x" + Integer.toHexString(bits) + ", '" + fmt + "', " + prec + ")");
    }

    private static void checkBinary(long bits, int bitSize, String expected) {
        String actual = GoFloatFmt.formatBinary(Double.longBitsToDouble(bits), bitSize);
        assertEquals(expected, actual,
                "formatBinary(0x" + Long.toHexString(bits) + ", " + bitSize + ")");
    }

    private static void checkBinary32(int bits, String expected) {
        String actual = GoFloatFmt.formatBinary((double) Float.intBitsToFloat(bits), 32);
        assertEquals(expected, actual,
                "formatBinary32(0x" + Integer.toHexString(bits) + ")");
    }

    private static void checkComplex(long reBits, long imBits, char fmt, int prec, int bitSize, String expected) {
        String actual = GoFloatFmt.formatComplex(
                Double.longBitsToDouble(reBits), Double.longBitsToDouble(imBits), fmt, prec, bitSize);
        assertEquals(expected, actual,
                "formatComplex(0x" + Long.toHexString(reBits) + ", 0x" + Long.toHexString(imBits)
                        + ", '" + fmt + "', " + prec + ", " + bitSize + ")");
    }

    private static void checkComplex32(int reBits, int imBits, char fmt, int prec, String expected) {
        String actual = GoFloatFmt.formatComplex(
                (double) Float.intBitsToFloat(reBits), (double) Float.intBitsToFloat(imBits), fmt, prec, 64);
        assertEquals(expected, actual,
                "formatComplex32(0x" + Integer.toHexString(reBits) + ", 0x" + Integer.toHexString(imBits)
                        + ", '" + fmt + "', " + prec + ")");
    }

    /**
     * Shortest %g (prec -1) for float64: normals, the 1e-4/1e-5 and 1e20/1e21
     * e/f boundaries, max/min-normal, and the whole subnormal family
     * (bits 1..16, largest subnormal) incl. the 9.88e-324 power-of-ten
     * carry that exercises the second unit alignment in
     * shortestSubnormalParts.
     */
    public void testShortestFloat64() {
        check(0x0000000000000000L, 'g', -1, 64, "0");
        check(0x8000000000000000L, 'g', -1, 64, "-0");
        check(0x3FF0000000000000L, 'g', -1, 64, "1");
        check(0xBFF0000000000000L, 'g', -1, 64, "-1");
        check(0x3FB999999999999AL, 'g', -1, 64, "0.1");
        check(0x3FB9999999999999L, 'g', -1, 64, "0.09999999999999999");
        check(0x3FB999999999999BL, 'g', -1, 64, "0.10000000000000002");
        check(0x444B1AE4D6E2EF50L, 'g', -1, 64, "1e+21");
        check(0x4415AF1D78B58C40L, 'g', -1, 64, "1e+20");
        check(0x40FE240000000000L, 'g', -1, 64, "123456");
        check(0x4132D68700000000L, 'g', -1, 64, "1.234567e+06");
        check(0x3F1A36E2EB1C432DL, 'g', -1, 64, "0.0001");
        check(0x3EE4F8B588E368F1L, 'g', -1, 64, "1e-05");
        check(0x419D6F34547E6B75L, 'g', -1, 64, "1.2345678912345679e+08");
        check(0x7FEFFFFFFFFFFFFFL, 'g', -1, 64, "1.7976931348623157e+308");
        check(0x0010000000000000L, 'g', -1, 64, "2.2250738585072014e-308");
        check(0x000FFFFFFFFFFFFFL, 'g', -1, 64, "2.225073858507201e-308");
        check(0x0000000000000001L, 'g', -1, 64, "5e-324");
        check(0x0000000000000002L, 'g', -1, 64, "1e-323");
        check(0x0000000000000003L, 'g', -1, 64, "1.5e-323");
        check(0x0000000000000004L, 'g', -1, 64, "2e-323");
        check(0x0000000000000005L, 'g', -1, 64, "2.5e-323");
        check(0x000000000000000AL, 'g', -1, 64, "5e-323");
        check(0x000000000000000FL, 'g', -1, 64, "7.4e-323");
        check(0x0000000000000010L, 'g', -1, 64, "8e-323");
        check(0x0000000000000100L, 'g', -1, 64, "1.265e-321");
        check(0x0008000000000001L, 'g', -1, 64, "1.112536929253601e-308");
        check(0x3FC3333333333333L, 'g', -1, 64, "0.15");
        check(0x3FD3333333333333L, 'g', -1, 64, "0.3");
        check(0x3FD5555555555555L, 'g', -1, 64, "0.3333333333333333");
        check(0x3FE5555555555555L, 'g', -1, 64, "0.6666666666666666");
        check(0x400921FB54442D18L, 'g', -1, 64, "3.141592653589793");
        check(0x430C6BF526340004L, 'g', -1, 64, "1.0000000000000005e+15");
        check(0x3FF8000000000000L, 'g', -1, 64, "1.5");
        check(0xC004000000000000L, 'g', -1, 64, "-2.5");
        check(0x7FF8000000000000L, 'g', -1, 64, "NaN");
        check(0x7FF0000000000000L, 'g', -1, 64, "+Inf");
        check(0xFFF0000000000000L, 'g', -1, 64, "-Inf");
        check(0x0010000000000001L, 'g', -1, 64, "2.225073858507202e-308");
        check(0x0000000000000008L, 'g', -1, 64, "4e-323");
        check(0x3EE4F8B588E368F0L, 'g', -1, 64, "9.999999999999999e-06");
        check(0x3EE4F8B588E368F2L, 'g', -1, 64, "1.0000000000000003e-05");
        check(0x412E847F00000000L, 'g', -1, 64, "999999.5");
        check(0x4415AF1D78B58C3FL, 'g', -1, 64, "9.999999999999998e+19");
        check(0x4415AF1D78B58C41L, 'g', -1, 64, "1.0000000000000002e+20");
    }

    /**
     * Shortest %g for float32: normals, max/min-normal, and the subnormal
     * family down to 1.4e-45 (bits 1..16, largest subnormal).
     */
    public void testShortestFloat32() {
        check32(0x00000000, 'g', -1, "0");
        check32(0x00000000, 'G', -1, "0");
        check32(0x80000000, 'g', -1, "-0");
        check32(0x80000000, 'G', -1, "-0");
        check32(0x3F800000, 'g', -1, "1");
        check32(0x3F800000, 'G', -1, "1");
        check32(0xBF800000, 'g', -1, "-1");
        check32(0xBF800000, 'G', -1, "-1");
        check32(0x3DCCCCCD, 'g', -1, "0.1");
        check32(0x3DCCCCCD, 'G', -1, "0.1");
        check32(0x3DCCCCCC, 'g', -1, "0.099999994");
        check32(0x3DCCCCCC, 'G', -1, "0.099999994");
        check32(0x3DCCCCCE, 'g', -1, "0.10000001");
        check32(0x3DCCCCCE, 'G', -1, "0.10000001");
        check32(0x7F7FFFFF, 'g', -1, "3.4028235e+38");
        check32(0x7F7FFFFF, 'G', -1, "3.4028235E+38");
        check32(0x00800000, 'g', -1, "1.1754944e-38");
        check32(0x00800000, 'G', -1, "1.1754944E-38");
        check32(0x007FFFFF, 'g', -1, "1.1754942e-38");
        check32(0x007FFFFF, 'G', -1, "1.1754942E-38");
        check32(0x00000001, 'g', -1, "1e-45");
        check32(0x00000001, 'G', -1, "1E-45");
        check32(0x00000002, 'g', -1, "3e-45");
        check32(0x00000002, 'G', -1, "3E-45");
        check32(0x00000003, 'g', -1, "4e-45");
        check32(0x00000003, 'G', -1, "4E-45");
        check32(0x00000004, 'g', -1, "6e-45");
        check32(0x00000004, 'G', -1, "6E-45");
        check32(0x00000005, 'g', -1, "7e-45");
        check32(0x00000005, 'G', -1, "7E-45");
        check32(0x0000000A, 'g', -1, "1.4e-44");
        check32(0x0000000A, 'G', -1, "1.4E-44");
        check32(0x00000010, 'g', -1, "2.2e-44");
        check32(0x00000010, 'G', -1, "2.2E-44");
        check32(0x00000100, 'g', -1, "3.59e-43");
        check32(0x00000100, 'G', -1, "3.59E-43");
        check32(0x3FC00000, 'g', -1, "1.5");
        check32(0x3FC00000, 'G', -1, "1.5");
        check32(0x4B000000, 'g', -1, "8.388608e+06");
        check32(0x4B000000, 'G', -1, "8.388608E+06");
        check32(0x4B000001, 'g', -1, "8.388609e+06");
        check32(0x4B000001, 'G', -1, "8.388609E+06");
        check32(0x7F800000, 'g', -1, "+Inf");
        check32(0x7F800000, 'G', -1, "+Inf");
        check32(0xFF800000, 'g', -1, "-Inf");
        check32(0xFF800000, 'G', -1, "-Inf");
        check32(0x7FC00000, 'g', -1, "NaN");
        check32(0x7FC00000, 'G', -1, "NaN");
        check32(0x33D6BF95, 'g', -1, "1e-07");
        check32(0x33D6BF95, 'G', -1, "1E-07");
        check32(0x322BCC77, 'g', -1, "1e-08");
        check32(0x322BCC77, 'G', -1, "1E-08");
    }

    /**
     * Fixed-precision %g/%G: the e/f decision at exp -4/-5 and exp &gt;= eprec
     * (1234567 prec 6 -&gt; e, prec 7 -&gt; f; 100000 prec 5 -&gt; e), prec 0
     * (one significant digit), prec 17/21 expansions, and rounding of
     * 1.5/2.5/3.5 to one digit.
     */
    public void testGPrecision() {
        check(0x4132D68700000000L, 'g', 6, 64, "1.23457e+06");
        check(0x4132D68700000000L, 'G', 6, 64, "1.23457E+06");
        check(0x40FE240000000000L, 'g', 6, 64, "123456");
        check(0x40FE240000000000L, 'G', 6, 64, "123456");
        check(0x40F86A0000000000L, 'g', 6, 64, "100000");
        check(0x40F86A0000000000L, 'G', 6, 64, "100000");
        check(0x4132D68700000000L, 'g', 7, 64, "1234567");
        check(0x4132D68700000000L, 'G', 7, 64, "1234567");
        check(0x4132D68700000000L, 'g', 5, 64, "1.2346e+06");
        check(0x4132D68700000000L, 'G', 5, 64, "1.2346E+06");
        check(0x4132D68700000000L, 'g', 1, 64, "1e+06");
        check(0x4132D68700000000L, 'G', 1, 64, "1E+06");
        check(0x4132D68700000000L, 'g', 0, 64, "1e+06");
        check(0x4132D68700000000L, 'G', 0, 64, "1E+06");
        check(0x3F1A36E2EB1C432DL, 'g', 6, 64, "0.0001");
        check(0x3F1A36E2EB1C432DL, 'G', 6, 64, "0.0001");
        check(0x3EE4F8B588E368F1L, 'g', 6, 64, "1e-05");
        check(0x3EE4F8B588E368F1L, 'G', 6, 64, "1E-05");
        check(0x3F1A36E2EB1C432DL, 'g', 1, 64, "0.0001");
        check(0x3F1A36E2EB1C432DL, 'G', 1, 64, "0.0001");
        check(0x3FB999999999999AL, 'g', 0, 64, "0.1");
        check(0x3FB999999999999AL, 'G', 0, 64, "0.1");
        check(0x3FB999999999999AL, 'g', 1, 64, "0.1");
        check(0x3FB999999999999AL, 'G', 1, 64, "0.1");
        check(0x3FB999999999999AL, 'g', 2, 64, "0.1");
        check(0x3FB999999999999AL, 'G', 2, 64, "0.1");
        check(0x3FB999999999999AL, 'g', 17, 64, "0.10000000000000001");
        check(0x3FB999999999999AL, 'G', 17, 64, "0.10000000000000001");
        check(0x3FB999999999999AL, 'g', 21, 64, "0.100000000000000005551");
        check(0x3FB999999999999AL, 'G', 21, 64, "0.100000000000000005551");
        check(0x40F86A0000000000L, 'g', 5, 64, "1e+05");
        check(0x40F86A0000000000L, 'G', 5, 64, "1E+05");
        check(0x40F86A0000000000L, 'g', 4, 64, "1e+05");
        check(0x40F86A0000000000L, 'G', 4, 64, "1E+05");
        check(0x412E847F00000000L, 'g', 6, 64, "1e+06");
        check(0x412E847F00000000L, 'G', 6, 64, "1E+06");
        check(0x412E847F00000000L, 'g', 7, 64, "999999.5");
        check(0x412E847F00000000L, 'G', 7, 64, "999999.5");
        check(0x3FF8000000000000L, 'g', 1, 64, "2");
        check(0x3FF8000000000000L, 'G', 1, 64, "2");
        check(0x3FF8000000000000L, 'g', 0, 64, "2");
        check(0x3FF8000000000000L, 'G', 0, 64, "2");
        check(0x4004000000000000L, 'g', 1, 64, "2");
        check(0x4004000000000000L, 'G', 1, 64, "2");
        check(0x4008000000000000L, 'g', 1, 64, "3");
        check(0x4008000000000000L, 'G', 1, 64, "3");
        check(0x3FF0000000000000L, 'g', 17, 64, "1");
        check(0x3FF0000000000000L, 'G', 17, 64, "1");
        check(0x3FF0000000000000L, 'g', 21, 64, "1");
        check(0x3FF0000000000000L, 'G', 21, 64, "1");
        check(0x0000000000000000L, 'g', 2, 64, "0");
        check(0x0000000000000000L, 'G', 2, 64, "0");
        check(0x8000000000000000L, 'g', 2, 64, "-0");
        check(0x8000000000000000L, 'G', 2, 64, "-0");
        check(0x7FF8000000000000L, 'g', 2, 64, "NaN");
        check(0x7FF8000000000000L, 'G', 2, 64, "NaN");
        check(0x7FF0000000000000L, 'g', 2, 64, "+Inf");
        check(0x7FF0000000000000L, 'G', 2, 64, "+Inf");
        check(0xFFF0000000000000L, 'g', 2, 64, "-Inf");
        check(0xFFF0000000000000L, 'G', 2, 64, "-Inf");
        check32(0x00000000, 'g', 6, "0");
        check32(0x80000000, 'g', 6, "-0");
        check32(0x3F800000, 'g', 6, "1");
        check32(0xBF800000, 'g', 6, "-1");
        check32(0x3DCCCCCD, 'g', 6, "0.1");
        check32(0x3DCCCCCC, 'g', 6, "0.1");
        check32(0x3DCCCCCE, 'g', 6, "0.1");
        check32(0x7F7FFFFF, 'g', 6, "3.40282e+38");
        check32(0x00800000, 'g', 6, "1.17549e-38");
        check32(0x007FFFFF, 'g', 6, "1.17549e-38");
        check32(0x00000001, 'g', 6, "1.4013e-45");
        check32(0x00000002, 'g', 6, "2.8026e-45");
        check32(0x00000003, 'g', 6, "4.2039e-45");
        check32(0x00000004, 'g', 6, "5.60519e-45");
        check32(0x00000005, 'g', 6, "7.00649e-45");
        check32(0x0000000A, 'g', 6, "1.4013e-44");
        check32(0x00000010, 'g', 6, "2.24208e-44");
        check32(0x00000100, 'g', 6, "3.58732e-43");
        check32(0x3FC00000, 'g', 6, "1.5");
        check32(0x4B000000, 'g', 6, "8.38861e+06");
        check32(0x4B000001, 'g', 6, "8.38861e+06");
        check32(0x7F800000, 'g', 6, "+Inf");
        check32(0xFF800000, 'g', 6, "-Inf");
        check32(0x7FC00000, 'g', 6, "NaN");
        check32(0x33D6BF95, 'g', 6, "1e-07");
        check32(0x322BCC77, 'g', 6, "1e-08");
        check32(0x3E800000, 'g', 0, "0.2");
        check32(0x3EC00000, 'g', 0, "0.4");
        check32(0x3F000000, 'g', 0, "0.5");
        check32(0x3F400000, 'g', 0, "0.8");
        check32(0x40000000, 'g', 0, "2");
        check32(0x40400000, 'g', 0, "3");
        check32(0x40400000, 'g', 1, "3");
        check32(0x00000001, 'g', 2, "1.4e-45");
    }

    /**
     * Fixed-precision %e/%E/%f: half-to-even rounding on exact binary halves
     * (0.125 -&gt; "0.12", 0.375 -&gt; "0.38", 0.625 -&gt; "0.62", 2.5 -&gt; "2",
     * 3.5 -&gt; "4"), values rounding to zero (5e-324, 1e-300 %f), the
     * 999999.5 carry to "1000000"/"1e+06", subnormals at %e prec 0/2/6,
     * and specials (&plusmn;0, NaN, &plusmn;Inf) at fixed precision.
     */
    public void testFixedEAndF() {
        check(0x4008000000000000L, 'e', 0, 64, "3e+00");
        check(0x4008000000000000L, 'f', 0, 64, "3");
        check(0x4008000000000000L, 'E', 0, 64, "3E+00");
        check(0x4004000000000000L, 'e', 0, 64, "2e+00");
        check(0x4004000000000000L, 'f', 0, 64, "2");
        check(0x4004000000000000L, 'E', 0, 64, "2E+00");
        check(0x3FC0000000000000L, 'e', 2, 64, "1.25e-01");
        check(0x3FC0000000000000L, 'f', 2, 64, "0.12");
        check(0x3FC0000000000000L, 'E', 2, 64, "1.25E-01");
        check(0x3FD8000000000000L, 'e', 2, 64, "3.75e-01");
        check(0x3FD8000000000000L, 'f', 2, 64, "0.38");
        check(0x3FD8000000000000L, 'E', 2, 64, "3.75E-01");
        check(0x3FE4000000000000L, 'e', 2, 64, "6.25e-01");
        check(0x3FE4000000000000L, 'f', 2, 64, "0.62");
        check(0x3FE4000000000000L, 'E', 2, 64, "6.25E-01");
        check(0x3FE8000000000000L, 'e', 2, 64, "7.50e-01");
        check(0x3FE8000000000000L, 'f', 2, 64, "0.75");
        check(0x3FE8000000000000L, 'E', 2, 64, "7.50E-01");
        check(0x3FEC000000000000L, 'e', 2, 64, "8.75e-01");
        check(0x3FEC000000000000L, 'f', 2, 64, "0.88");
        check(0x3FEC000000000000L, 'E', 2, 64, "8.75E-01");
        check(0x3FC0000000000000L, 'e', 0, 64, "1e-01");
        check(0x3FC0000000000000L, 'f', 0, 64, "0");
        check(0x3FC0000000000000L, 'E', 0, 64, "1E-01");
        check(0x3FD8000000000000L, 'e', 0, 64, "4e-01");
        check(0x3FD8000000000000L, 'f', 0, 64, "0");
        check(0x3FD8000000000000L, 'E', 0, 64, "4E-01");
        check(0x3FE4000000000000L, 'e', 0, 64, "6e-01");
        check(0x3FE4000000000000L, 'f', 0, 64, "1");
        check(0x3FE4000000000000L, 'E', 0, 64, "6E-01");
        check(0x3FE8000000000000L, 'e', 0, 64, "8e-01");
        check(0x3FE8000000000000L, 'f', 0, 64, "1");
        check(0x3FE8000000000000L, 'E', 0, 64, "8E-01");
        check(0x0000000000000001L, 'e', 2, 64, "4.94e-324");
        check(0x0000000000000001L, 'f', 2, 64, "0.00");
        check(0x0000000000000001L, 'E', 2, 64, "4.94E-324");
        check(0x0000000000000001L, 'e', 0, 64, "5e-324");
        check(0x0000000000000001L, 'f', 0, 64, "0");
        check(0x0000000000000001L, 'E', 0, 64, "5E-324");
        check(0x0000000000000001L, 'e', 6, 64, "4.940656e-324");
        check(0x0000000000000001L, 'f', 6, 64, "0.000000");
