    /**
     * Binary %b: exact mantissa/exponent rendering for normals,
     * subnormals, &plusmn;0, NaN/Inf, float64 and float32.
     */
    public void testBinaryFloat() {
        checkBinary(0x3FF8000000000000L, 64, "6755399441055744p-52");
        checkBinary(0xBFF8000000000000L, 64, "-6755399441055744p-52");
        checkBinary(0x3FB999999999999AL, 64, "7205759403792794p-56");
        checkBinary(0x3FF0000000000000L, 64, "4503599627370496p-52");
        checkBinary(0x3FE0000000000000L, 64, "4503599627370496p-53");
        checkBinary(0x4000000000000000L, 64, "4503599627370496p-51");
        checkBinary(0x0000000000000001L, 64, "1p-1074");
        checkBinary(0x0000000000000000L, 64, "0p-1074");
        checkBinary(0x8000000000000000L, 64, "-0p-1074");
        checkBinary(0x7FF8000000000000L, 64, "NaN");
        checkBinary(0x7FF0000000000000L, 64, "+Inf");
        checkBinary(0xFFF0000000000000L, 64, "-Inf");
        checkBinary32(0x3FC00000, "12582912p-23");
        checkBinary32(0x3DCCCCCD, "13421773p-27");
        checkBinary32(0x00000001, "1p-149");
        checkBinary32(0x00000000, "0p-149");
        checkBinary32(0x7F800000, "+Inf");
        checkBinary32(0x7FC00000, "NaN");
    }

    /**
     * Complex: (re+imi) layout, sign insertion for negative imaginary
     * parts, -0 components, subnormal components, NaN/Inf components,
     * and complex64 (float32 parts) vs complex128.
     */
    public void testComplex() {
        checkComplex(0x3FF8000000000000L, 0xC004000000000000L, 'g', -1, 128, "(1.5-2.5i)");
        checkComplex(0x0000000000000000L, 0x0000000000000000L, 'g', -1, 128, "(0+0i)");
        checkComplex(0x8000000000000000L, 0x0000000000000000L, 'g', -1, 128, "(-0+0i)");
        checkComplex(0x0000000000000000L, 0x8000000000000000L, 'g', -1, 128, "(0-0i)");
        checkComplex(0x3FF0000000000000L, 0x0000000000000000L, 'g', -1, 128, "(1+0i)");
        checkComplex(0x0000000000000000L, 0x3FF0000000000000L, 'g', -1, 128, "(0+1i)");
        checkComplex(0x7FF8000000000000L, 0x3FF0000000000000L, 'g', -1, 128, "(NaN+1i)");
        checkComplex(0x7FF0000000000000L, 0xFFF0000000000000L, 'g', -1, 128, "(+Inf-Infi)");
        checkComplex(0x3EE4F8B588E368F1L, 0x4132D68700000000L, 'g', -1, 128, "(1e-05+1.234567e+06i)");
        checkComplex(0x3FF8000000000000L, 0xC004000000000000L, 'g', 6, 128, "(1.5-2.5i)");
        checkComplex(0x3FF8000000000000L, 0xC004000000000000L, 'e', 2, 128, "(1.50e+00-2.50e+00i)");
        checkComplex(0x3FF8000000000000L, 0xC004000000000000L, 'f', 2, 128, "(1.50-2.50i)");
        checkComplex(0x0000000000000001L, 0x0000000000000001L, 'g', -1, 128, "(5e-324+5e-324i)");
        checkComplex(0x0000000000000001L, 0x0000000000000001L, 'e', 2, 128, "(4.94e-324+4.94e-324i)");
        checkComplex32(0x3FC00000, 0xC0200000, 'g', -1, "(1.5-2.5i)");
        checkComplex32(0x00000000, 0x00000000, 'g', -1, "(0+0i)");
        checkComplex32(0x00000001, 0x00000001, 'g', -1, "(1e-45+1e-45i)");
        checkComplex32(0x3FC00000, 0xC0200000, 'e', 2, "(1.50e+00-2.50e+00i)");
        checkComplex32(0x3FC00000, 0xC0200000, 'f', 2, "(1.50-2.50i)");
        checkComplex32(0x7FC00000, 0x3F800000, 'g', -1, "(NaN+1i)");
        checkComplex32(0x7F800000, 0xFF800000, 'g', -1, "(+Inf-Infi)");
    }
}
