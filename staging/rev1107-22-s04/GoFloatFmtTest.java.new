    /**
     * Hex float %x/%X: shortest and fixed precisions -1..20 (the prec-15
     * rounding edge is the boundary of the port's prec &lt; 15 guard),
     * subnormals (5e-324 -&gt; 0x0.0000000000001p-1022), min normal,
     * max, &plusmn;0, NaN/Inf, and float32 hex.
     */
    public void testHexFloat() {
        checkHex(0x3FF8000000000000L, 'x', -1, 64, "0x1.8p+00");
        checkHex(0x3FF8000000000000L, 'x', 0, 64, "0x1p+01");
        checkHex(0x3FF8000000000000L, 'x', 1, 64, "0x1.8p+00");
        checkHex(0x3FF8000000000000L, 'x', 2, 64, "0x1.80p+00");
        checkHex(0x3FF8000000000000L, 'x', 6, 64, "0x1.800000p+00");
        checkHex(0x3FF8000000000000L, 'x', 13, 64, "0x1.8000000000000p+00");
        checkHex(0x3FF8000000000000L, 'x', 14, 64, "0x1.80000000000000p+00");
        checkHex(0x3FF8000000000000L, 'x', 15, 64, "0x1.800000000000000p+00");
        checkHex(0x3FF8000000000000L, 'x', 16, 64, "0x1.8000000000000000p+00");
        checkHex(0x3FF8000000000000L, 'x', 20, 64, "0x1.80000000000000000000p+00");
        checkHex(0x3FF8000000000000L, 'X', -1, 64, "0X1.8P+00");
        checkHex(0x3FF8000000000000L, 'X', 2, 64, "0X1.80P+00");
        checkHex(0x3FF8000000000000L, 'X', 6, 64, "0X1.800000P+00");
        checkHex(0xBFF8000000000000L, 'x', -1, 64, "-0x1.8p+00");
        checkHex(0xBFF8000000000000L, 'x', 0, 64, "-0x1p+01");
        checkHex(0xBFF8000000000000L, 'x', 1, 64, "-0x1.8p+00");
        checkHex(0xBFF8000000000000L, 'x', 2, 64, "-0x1.80p+00");
        checkHex(0xBFF8000000000000L, 'x', 6, 64, "-0x1.800000p+00");
        checkHex(0xBFF8000000000000L, 'x', 13, 64, "-0x1.8000000000000p+00");
        checkHex(0xBFF8000000000000L, 'x', 14, 64, "-0x1.80000000000000p+00");
        checkHex(0xBFF8000000000000L, 'x', 15, 64, "-0x1.800000000000000p+00");
        checkHex(0xBFF8000000000000L, 'x', 16, 64, "-0x1.8000000000000000p+00");
        checkHex(0xBFF8000000000000L, 'x', 20, 64, "-0x1.80000000000000000000p+00");
        checkHex(0xBFF8000000000000L, 'X', -1, 64, "-0X1.8P+00");
