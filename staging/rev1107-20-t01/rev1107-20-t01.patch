+// testRunConfig is the minimal config Run needs: both backends present.
+// No backend is ever invoked when the kept set is empty.
+func testRunConfig() *harness.Config {
+	return &harness.Config{Backends: []harness.Backend{{Name: "gc-a"}, {Name: "graalgo"}}}
+}
+
+// TestRunEmptyKeptSet pins R20-T01: when every scanned file is excluded,
+// Run must fail loudly instead of returning ([], nil), which made both
+// `typeparam run` and `srctest run` print "0 comparisons, 0 diverged"
+// and exit 0 — a vacuous PASS of the conformance gate.
+func TestRunEmptyKeptSet(t *testing.T) {
+	files := []TFile{
+		{Name: "a.go", Class: "exclude:deferred-parity"},
+		{Name: "b.go", Class: "exclude:backend-specific"},
+	}
+	if _, err := Run(testRunConfig(), files, "gc-a", "graalgo", 2); err == nil {
+		t.Fatal("Run with all files excluded: want error, got nil (vacuous PASS)")
+	}
+}
+
+// TestRunNoFiles pins the same R20-T01 hole for an empty scan: a wrong
+// -dir with no .go files must fail, not compare nothing and pass.
+func TestRunNoFiles(t *testing.T) {
+	if _, err := Run(testRunConfig(), nil, "gc-a", "graalgo", 2); err == nil {
+		t.Fatal("Run with no files: want error, got nil (vacuous PASS)")
+	}
+}
