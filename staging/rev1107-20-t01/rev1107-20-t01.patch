+// TestSnapshotRecord_ZeroKeptSet pins R20-T01 (second-order hole): when
+// the config exclusions cover every corpus program, `snapshot record`
+// must fail instead of writing a 0-program snapshot that a later
+// `snapshot check` with the same exclusions would pass having verified
+// nothing. The dummy backend is never invoked: the guard fires before
+// any program runs.
+func TestSnapshotRecord_ZeroKeptSet(t *testing.T) {
+	dir := t.TempDir()
+	progDir := filepath.Join(dir, "corpus", "prog")
+	if err := os.MkdirAll(progDir, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(progDir, "main.go"), []byte("package main\nfunc main() {}\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	cfgPath := filepath.Join(dir, "backends.json")
+	cfg := `{"backends":[{"name":"graalgo","build":["/bin/false"],"run":["/bin/false"]}],"exclusions":[{"program":"prog","reason":"flaky"}],"timeoutSec":15}`
+	if err := os.WriteFile(cfgPath, []byte(cfg), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	out := filepath.Join(dir, "snap.json")
+	err := cmdSnapshotRecord([]string{
+		"-config", cfgPath, "-corpus", filepath.Join(dir, "corpus"),
+		"-backend", "graalgo", "-out", out, "-toolchain", "go1.27.1", "-runs", "1",
+	})
+	if err == nil {
+		t.Fatal("snapshot record with every program excluded: want error, got nil (vacuous snapshot)")
+	}
+	if _, statErr := os.Stat(out); !os.IsNotExist(statErr) {
+		t.Fatalf("snapshot record with zero programs wrote %s (want no file)", out)
+	}
+}
