+func TestResolveFilesImportPathModuleCache(t *testing.T) {
+	// A single pinned version in a scratch module cache: the package and
+	// its subpackage both resolve. Which version is picked when several
+	// are cached is R20-F03's territory and is deliberately not pinned.
+	cache := t.TempDir()
+	writeFile(t, cache, filepath.Join("example.com", "thing@v1.2.3", "a.go"), "package thing\n\nfunc A() {}\n")
+	writeFile(t, cache, filepath.Join("example.com", "thing@v1.2.3", "sub", "b.go"), "package sub\n\nfunc B() {}\n")
+	t.Setenv("GOMODCACHE", cache)
+
+	files, err := resolveFiles([]string{"example.com/thing"})
+	if err != nil {
+		t.Fatalf("resolveFiles(module cache): %v", err)
+	}
+	containsFile(t, files, filepath.Join(cache, "example.com", "thing@v1.2.3", "a.go"))
+
+	files, err = resolveFiles([]string{"example.com/thing/sub"})
+	if err != nil {
+		t.Fatalf("resolveFiles(module cache subpackage): %v", err)
+	}
+	containsFile(t, files, filepath.Join(cache, "example.com", "thing@v1.2.3", "sub", "b.go"))
+}
