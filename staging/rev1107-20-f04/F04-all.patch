+func TestResolveFilesImportPathDoesNotShadowStdlib(t *testing.T) {
+	// Import-first precedence, like `go`: a local directory named fmt
+	// does not shadow the stdlib package of the same name; use ./fmt
+	// for the directory. (Deliberate change from the old driver
+	// behavior, which always preferred the local directory.)
+	goroot := runtime.GOROOT()
+	if goroot == "" {
+		t.Skip("no GOROOT")
+	}
+	mod := tempModuleDir(t, "example.com/m")
+	writeFile(t, mod, filepath.Join("fmt", "local.go"), "package main\n\nfunc main() {}\n")
+	chdirTo(t, mod)
+
+	files, err := resolveFiles([]string{"fmt"})
+	if err != nil {
+		t.Fatalf("resolveFiles(%q): %v", "fmt", err)
+	}
+	containsFile(t, files, filepath.Join(goroot, "src", "fmt", "print.go"))
+	for _, f := range files {
+		if f == filepath.Join(mod, "fmt", "local.go") {
+			t.Errorf("resolveFiles(%q) = %v, local ./fmt must not shadow stdlib fmt", "fmt", files)
+		}
+	}
+
+	// ... and the local directory is still reachable explicitly.
+	files, err = resolveFiles([]string{"./fmt"})
+	if err != nil {
+		t.Fatalf("resolveFiles(%q): %v", "./fmt", err)
+	}
+	containsFile(t, files, filepath.Join("fmt", "local.go"))
+}
