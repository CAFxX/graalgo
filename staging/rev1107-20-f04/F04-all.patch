+func TestCmdFmtImportPath(t *testing.T) {
+	setTestGoRoot(t)
+	mod := tempModuleDir(t, "example.com/m")
+	mainGo := filepath.Join(mod, "cmd", "hello", "main.go")
+	unformatted := "package main\n\nfunc  main()  {  println(\"x\")  }\n"
+	writeFile(t, mod, "cmd/hello/main.go", unformatted)
+	chdirTo(t, mod)
+	root := filepath.Join(t.TempDir(), "fake-root") // cmdFmt ignores root
+
+	format := func(args ...string) {
+		t.Helper()
+		if code := cmdFmt(root, args); code != 0 {
+			t.Fatalf("cmdFmt(%v) = %d, want 0", args, code)
+		}
+		data, err := os.ReadFile(mainGo)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if strings.Contains(string(data), "func  main") {
+			t.Fatalf("cmdFmt(%v) did not format the file: %q", args, data)
+		}
+	}
+	// Import path form.
+	format("example.com/m/cmd/hello")
+	// Directory form.
+	writeFile(t, mod, "cmd/hello/main.go", unformatted)
+	format("cmd/hello")
+	// Explicit .go file form.
+	writeFile(t, mod, "cmd/hello/main.go", unformatted)
+	format(mainGo)
+}
