+package main
+
+import (
+	"os"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"testing"
+)
+
+// R20-F04: resolveFiles and resolveTestDirs must resolve import paths to
+// package directories (same-module via the enclosing go.mod, stdlib via
+// GOROOT, third-party via the module cache then GOPATH/src), like `go`.
+// Previously both functions did os.Stat on each argument, so any import
+// path failed with "no such file or directory" even though the usage
+// strings advertise [packages].
+
+// tempModuleDir creates a scratch module with the given module path and
+// returns its root directory.
+func tempModuleDir(t *testing.T, modulePath string) string {
+	t.Helper()
+	dir := filepath.Join(t.TempDir(), "mod")
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	writeFile(t, dir, "go.mod", "module "+modulePath+"\n\ngo 1.21\n")
+	return dir
+}
+
+// chdirTo changes the working directory to dir for the duration of the test.
+func chdirTo(t *testing.T, dir string) {
+	t.Helper()
+	oldWd, err := os.Getwd()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chdir(dir); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = os.Chdir(oldWd) })
+}
+
+// setTestGoRoot points GOROOT at the toolchain that built the test binary,
+// so findGofmt/findGoBinary resolve deterministically in command tests.
+func setTestGoRoot(t *testing.T) {
+	t.Helper()
+	t.Setenv("GOROOT", runtime.GOROOT())
+}
+
+// containsFile fails unless want is exactly one of files.
+func containsFile(t *testing.T, files []string, want string) {
+	t.Helper()
+	for _, f := range files {
+		if f == want {
+			return
+		}
+	}
+	t.Errorf("files = %v, want %q included", files, want)
+}
+
+// writeFakeBackend creates a fake graalgo installation root whose
+// graalgo-sync-run records every invocation to a log file and:
+//   - exits 0 for --check invocations, and for --emit-wire invocations
+//     (writing a minimal wire JSON to the --emit-wire path),
+//   - otherwise prints FAKE-RUN with its arguments and exits 0.
+//
+// It returns the root and the invocation log path.
+func writeFakeBackend(t *testing.T) (root, logPath string) {
+	t.Helper()
+	root = filepath.Join(t.TempDir(), "fake-root")
+	backendDir := filepath.Join(root, "internal", "backend")
+	if err := os.MkdirAll(backendDir, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	logPath = filepath.Join(t.TempDir(), "invocations.log")
+	script := "#!/usr/bin/env bash\n" +
+		"printf '%s\\n' \"INVOCATION: $*\" >> " + logPath + "\n" +
+		"for a in \"$@\"; do\n" +
+		"  case \"$a\" in\n" +
+		"    --emit-wire=*) printf '%s' '{\"frontend\":\"v1\",\"functions\":[]}' > \"${a#--emit-wire=}\" ;;\n" +
+		"  esac\n" +
+		"done\n" +
+		"if [ \"$1\" = \"--check\" ] || [ \"$2\" = \"--check\" ]; then exit 0; fi\n" +
+		"printf 'FAKE-RUN %s\\n' \"$*\"\n" +
+		"exit 0\n"
+	if err := os.WriteFile(filepath.Join(backendDir, "graalgo-sync-run"), []byte(script), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	return root, logPath
+}
