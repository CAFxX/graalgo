+func TestResolveFilesImportPathSameModule(t *testing.T) {
+	mod := tempModuleDir(t, "example.com/m")
+	writeFile(t, mod, "cmd/hello/main.go", "package main\n\nfunc main() {}\n")
+	writeFile(t, mod, "cmd/hello/util.go", "package main\n\nfunc util() {}\n")
+	chdirTo(t, mod)
+
+	files, err := resolveFiles([]string{"example.com/m/cmd/hello"})
+	if err != nil {
+		t.Fatalf("resolveFiles(import path): %v", err)
+	}
+	containsFile(t, files, filepath.Join(mod, "cmd", "hello", "main.go"))
+	containsFile(t, files, filepath.Join(mod, "cmd", "hello", "util.go"))
+
+	// From a subdirectory of the same module: module lookup walks up.
+	chdirTo(t, filepath.Join(mod, "cmd", "hello"))
+	files, err = resolveFiles([]string{"example.com/m/cmd/hello"})
+	if err != nil {
+		t.Fatalf("resolveFiles(import path from subdir): %v", err)
+	}
+	containsFile(t, files, filepath.Join(mod, "cmd", "hello", "main.go"))
+}
