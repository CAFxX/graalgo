+func TestCmdBuildImportPath(t *testing.T) {
+	setTestGoRoot(t)
+	mod := tempModuleDir(t, "example.com/m")
+	writeFile(t, mod, "cmd/hello/main.go", "package main\n\nfunc main() {}\n")
+	chdirTo(t, mod)
+	root, _ := writeFakeBackend(t)
+
+	out := filepath.Join(t.TempDir(), "hello")
+	if code := cmdBuild(root, []string{"-o", out, "example.com/m/cmd/hello"}); code != 0 {
+		t.Fatalf("cmdBuild(import path) = %d, want 0", code)
+	}
+	fi, err := os.Stat(out)
+	if err != nil {
+		t.Fatalf("artifact %s not created: %v", out, err)
+	}
+	if fi.Mode()&0o111 == 0 {
+		t.Errorf("artifact %s is not executable (mode %v)", out, fi.Mode())
+	}
+	if fi.Size() == 0 {
+		t.Errorf("artifact %s is empty", out)
+	}
+}
