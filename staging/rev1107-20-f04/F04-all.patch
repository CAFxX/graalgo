+func TestResolveFilesImportPathStdlib(t *testing.T) {
+	goroot := runtime.GOROOT()
+	if goroot == "" {
+		t.Skip("no GOROOT")
+	}
+	for _, tc := range []struct {
+		path string
+		file string
+	}{
+		{"fmt", filepath.Join(goroot, "src", "fmt", "print.go")},
+		{"net/http", filepath.Join(goroot, "src", "net", "http", "server.go")},
+	} {
+		files, err := resolveFiles([]string{tc.path})
+		if err != nil {
+			t.Fatalf("resolveFiles(%q): %v", tc.path, err)
+		}
+		if len(files) == 0 {
+			t.Fatalf("resolveFiles(%q) = no files", tc.path)
+		}
+		prefix := filepath.Join(goroot, "src", filepath.FromSlash(tc.path)) + string(filepath.Separator)
+		for _, f := range files {
+			if !strings.HasPrefix(f, prefix) {
+				t.Errorf("resolveFiles(%q): file %q is not under %q", tc.path, f, prefix)
+			}
+			if !strings.HasSuffix(f, ".go") {
+				t.Errorf("resolveFiles(%q): file %q is not a .go file", tc.path, f)
+			}
+		}
+		containsFile(t, files, tc.file)
+	}
+}
