+func TestResolveFilesFilesystemFormsStillWork(t *testing.T) {
+	// Guards for the argument forms that already worked: they must
+	// keep working exactly as before (these passed before the fix too).
+	mod := tempModuleDir(t, "example.com/m")
+	writeFile(t, mod, "pkg/a.go", "package pkg\n\nfunc A() {}\n")
+	writeFile(t, mod, "pkg/b_test.go", "package pkg\n\nimport \"testing\"\n\nfunc TestB(t *testing.T) {}\n")
+
+	// An explicitly named .go file passes through unchanged.
+	f := filepath.Join(mod, "pkg", "b_test.go")
+	files, err := resolveFiles([]string{f})
+	if err != nil {
+		t.Fatalf("resolveFiles(explicit file): %v", err)
+	}
+	if len(files) != 1 || files[0] != f {
+		t.Errorf("resolveFiles(explicit file) = %v, want [%q]", files, f)
+	}
+
+	// A directory argument expands to its .go files.
+	files, err = resolveFiles([]string{filepath.Join(mod, "pkg")})
+	if err != nil {
+		t.Fatalf("resolveFiles(directory): %v", err)
+	}
+	containsFile(t, files, filepath.Join(mod, "pkg", "a.go"))
+	containsFile(t, files, filepath.Join(mod, "pkg", "b_test.go"))
+
+	// "." expands the current directory (relative names, as today).
+	chdirTo(t, filepath.Join(mod, "pkg"))
+	files, err = resolveFiles([]string{"."})
+	if err != nil {
+		t.Fatalf("resolveFiles(%q): %v", ".", err)
+	}
+	containsFile(t, files, "a.go")
+
+	// A nonexistent .go file passes through for the backend to report.
+	missing := filepath.Join(mod, "pkg", "missing.go")
+	files, err = resolveFiles([]string{missing})
+	if err != nil {
+		t.Fatalf("resolveFiles(nonexistent .go file): %v", err)
+	}
+	if len(files) != 1 || files[0] != missing {
+		t.Errorf("resolveFiles(nonexistent .go file) = %v, want [%q]", files, missing)
+	}
+}
