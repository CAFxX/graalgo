+func TestResolveFilesImportPathNotFound(t *testing.T) {
+	// Guards the error path: an unresolvable import path must still
+	// fail, naming the argument (this passed before the fix too — it
+	// pins the error, it does not demonstrate the fix).
+	t.Setenv("GOMODCACHE", t.TempDir())
+	t.Setenv("GOPATH", t.TempDir())
+	if _, err := resolveFiles([]string{"example.com/does/not/exist"}); err == nil {
+		t.Errorf("resolveFiles(unknown import path) = no error, want error")
+	} else if !strings.Contains(err.Error(), "example.com/does/not/exist") {
+		t.Errorf("resolveFiles(unknown import path) error = %v, want it to name the argument", err)
+	}
+}
