+func TestCmdRunImportPath(t *testing.T) {
+	mod := tempModuleDir(t, "example.com/m")
+	writeFile(t, mod, "cmd/hello/main.go", "package main\n\nfunc main() {}\n")
+	writeFile(t, mod, "cmd/hello/util.go", "package main\n\nfunc util() {}\n")
+	chdirTo(t, mod)
+	root, logPath := writeFakeBackend(t)
+
+	// Import path, with program arguments after it.
+	if code := cmdRun(root, []string{"example.com/m/cmd/hello", "a1", "--flag"}); code != 0 {
+		t.Fatalf("cmdRun(import path) = %d, want 0", code)
+	}
+	log, err := os.ReadFile(logPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// The backend must have been invoked with the resolved package
+	// files (not the import path) plus the program arguments.
+	if !strings.Contains(string(log), filepath.Join(mod, "cmd", "hello", "main.go")) {
+		t.Errorf("backend log = %q, want the resolved main.go in the run invocation", log)
+	}
+	if !strings.Contains(string(log), "-- a1 --flag") {
+		t.Errorf("backend log = %q, want program args after --", log)
+	}
+
+	// A directory argument still works.
+	if code := cmdRun(root, []string{"cmd/hello"}); code != 0 {
+		t.Errorf("cmdRun(directory) = %d, want 0", code)
+	}
+	// Explicit .go files still work (they bypass package resolution).
+	if code := cmdRun(root, []string{filepath.Join(mod, "cmd", "hello", "main.go")}); code != 0 {
+		t.Errorf("cmdRun(.go file) = %d, want 0", code)
+	}
+}
