+func TestResolveTestDirsImportPath(t *testing.T) {
+	mod := tempModuleDir(t, "example.com/m")
+	writeFile(t, mod, "cmd/hello/main.go", "package main\n\nfunc main() {}\n")
+	writeFile(t, mod, "cmd/hello/main_test.go", "package main\n\nimport \"testing\"\n\nfunc TestX(t *testing.T) {}\n")
+	chdirTo(t, mod)
+
+	dirs, err := resolveTestDirs([]string{"example.com/m/cmd/hello"})
+	if err != nil {
+		t.Fatalf("resolveTestDirs(import path): %v", err)
+	}
+	want := filepath.Join(mod, "cmd", "hello")
+	if len(dirs) != 1 || dirs[0] != want {
+		t.Errorf("resolveTestDirs(import path) = %v, want [%q]", dirs, want)
+	}
+
+	// A single .go file still resolves to its directory.
+	dirs, err = resolveTestDirs([]string{filepath.Join(mod, "cmd", "hello", "main_test.go")})
+	if err != nil {
+		t.Fatalf("resolveTestDirs(.go file): %v", err)
+	}
+	if len(dirs) != 1 || dirs[0] != want {
+		t.Errorf("resolveTestDirs(.go file) = %v, want [%q]", dirs, want)
+	}
+
+	// An unknown import path still errors.
+	t.Setenv("GOMODCACHE", t.TempDir())
+	t.Setenv("GOPATH", t.TempDir())
+	if _, err := resolveTestDirs([]string{"example.com/nope"}); err == nil {
+		t.Errorf("resolveTestDirs(unknown import path) = no error, want error")
+	}
+}
