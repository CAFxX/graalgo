+// isFilesystemArg reports whether a is an explicit filesystem reference
+// rather than a bare package name: a relative (./, ../, .) or absolute
+// path, or a .go file. Such arguments are never import paths.
+func isFilesystemArg(a string) bool {
+	return strings.HasPrefix(a, ".") || filepath.IsAbs(a) || strings.HasSuffix(a, ".go")
+}
+
+// packageDirForArg maps a bare package argument to its source directory:
+// an import path resolved through the driver's existing import→directory
+// mapping (importDirForPath: same-module packages via the enclosing
+// go.mod, stdlib via GOROOT, third-party via the module cache then
+// GOPATH/src). It reports ok=false for explicit filesystem arguments
+// and for names that resolve to nothing, leaving the caller's existing
+// filesystem handling (including the local-directory fallback for bare
+// directory names) untouched.
+//
+// Precedence is import-first, like `go`: `graalgo build fmt` means the
+// stdlib package even when a ./fmt directory exists (use ./fmt for the
+// directory). This is a deliberate, documented change from the old
+// driver behavior, which always preferred the local directory; it
+// preserves every other bare-directory invocation, because a bare name
+// that is not a resolvable import path still falls through to the
+// caller's filesystem handling.
+//
+// Version note: module-cache lookup reuses findInModCache, which takes
+// the first matching cached version; the frontend's disk importer takes
+// the highest. Version selection policy (go.mod pins) is R20-F03's
+// territory — this function intentionally does not change it.
+func packageDirForArg(a string) (string, bool) {
+	if isFilesystemArg(a) {
+		return "", false
+	}
+	cwd, err := os.Getwd()
+	if err != nil {
+		cwd = "."
+	}
+	dir, err := importDirForPath(cwd, a)
+	if err != nil {
+		return "", false
+	}
+	return dir, true
+}
