+func TestResolveFilesImportPathGopath(t *testing.T) {
+	gp := t.TempDir()
+	writeFile(t, gp, filepath.Join("src", "example.com", "other", "c.go"), "package other\n\nfunc C() {}\n")
+	// An empty module cache, so the GOPATH/src fallback is exercised.
+	t.Setenv("GOMODCACHE", t.TempDir())
+	t.Setenv("GOPATH", gp)
+
+	files, err := resolveFiles([]string{"example.com/other"})
+	if err != nil {
+		t.Fatalf("resolveFiles(GOPATH): %v", err)
+	}
+	containsFile(t, files, filepath.Join(gp, "src", "example.com", "other", "c.go"))
+}
