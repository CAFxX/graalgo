diff --git a/tools/torture/README.md b/tools/torture/README.md
new file mode 100644
index 00000000..130e3caa
--- /dev/null
+++ b/tools/torture/README.md
@@ -0,0 +1,63 @@
+# Scheduler torture scripts
+
+Three scripts that torture the P2 userspace scheduler on the production
+path (spike 2b F1–F6), differential against `gc` where Go source is
+involved. Remediation of review findings QN-12/T13 (stale scripts) and
+T17 (shell hygiene).
+
+| Script | What it does |
+|---|---|
+| [run_battery.sh](run_battery.sh) | Runs every `TortureBattery` leg (F1/F3/F4/F5/F5b/F6) with several scheduler configs; exit 0 iff all legs pass |
+| [gmp_matrix.sh](gmp_matrix.sh) | GOMAXPROCS × workload matrix (`{1,2,4,N}` × `{compute,mixed}`): each [corpus](corpus/) program runs under graalgo (`--gmp=N`) and under `gc` (`GOMAXPROCS=N`); stderr compared byte-for-byte (corpus prints via `println`) |
+| [stress_differential.sh](stress_differential.sh) | Runs each [corpus](corpus/) program under graalgo and `gc`; `exact` mode compares stderr byte-for-byte, `completion` mode only requires clean completion on both |
+
+## Layout
+
+- Scripts: this directory. Logs: `internal/backend/runtime/out/torture/<name>/`
+  (gitignored via `out/` — per the repo [no-debris rule](../../AGENTS.md#5-no-debris-rule),
+  run evidence never lands in the tree).
+- Corpus: [corpus/](corpus/) (committed). Each program is deterministic by
+  construction (order-independent reductions), so `exact` comparisons are
+  schedule-independent.
+
+## Corpus constraints
+
+The corpus is deliberately restricted to what the Go toolchain can execute
+through the product launcher **on the current base**: goroutines, channels,
+plain (multi-value) calls, and the `println` builtin. The `fmt`/`os`/
+`context`/`runtime`/`sync/atomic` packages are not yet usable end-to-end
+(pre-existing toolchain gaps: a 3-valued `ifacemethod` assignment in the
+`fmt` closure breaks the backend's `buildAssign`; `os.Stdout` hits an NPE;
+`context` hits an interface-dispatch gap; `runtime` hangs). Because `fmt`
+is unavailable, programs print via the `println` builtin — which writes to
+**stderr** on both `gc` and graalgo — so the differential scripts compare
+stderr, not stdout. JVM/launcher warnings also land on stderr and will
+fail a cell; that is intended (toolchain noise is a signal).
+When the toolchain gaps close, extend the corpus (context cancellation,
+finalizers) — the `exact`/`completion` modes already support it.
+
+## Prerequisites
+
+- GraalVM at `$GRAALVM_HOME` (default `~/tools/graalvm-jdk-25`).
+- The backend modules built:
+  `make -C ../../internal/backend/truffle main` (runtime + truffle classes),
+  `make -C ../../internal/backend/interop main` (product-launcher classes)
+  — or run the make targets below, which build what they need.
+- For the two differential scripts: the `gofrontend` binary built
+  (see [internal/frontend/build.sh](../../internal/frontend/build.sh)) and
+  stock Go at `$GO` (default `~/tools/go/bin/go`).
+- Go programs run through the product launcher
+  (`internal/backend/graalgo-sync-run`, P3SyncMain): it drives the same
+  `SchedulerCore` under test with channels/select and the full stdlib
+  surface. The raw scheduler entry point
+  (`graalgo.sched.launcher.SchedMain`) cannot run real Go programs on the
+  current base (its Truffle `NodeFactory` lacks the `ifacemethod`/`makechan`
+  hooks), so the differential scripts deliberately do not use it.
+
+## Make targets
+
+In [internal/backend/runtime](../../internal/backend/runtime/):
+
+- `make torture` — the battery
+- `make gmp-matrix` — the GOMAXPROCS matrix
+- `make stress-differential` — the stress corpus differential
diff --git a/tools/torture/corpus/cancel_broadcast.go b/tools/torture/corpus/cancel_broadcast.go
new file mode 100644
index 00000000..f42cd498
--- /dev/null
+++ b/tools/torture/corpus/cancel_broadcast.go
@@ -0,0 +1,29 @@
+package main
+
+// cancel_broadcast: deterministic broadcast-cancellation pattern.
+//
+// Eight workers block on a done channel; the main goroutine closes it,
+// each worker reports through a buffered channel, and the main goroutine
+// sums the worker ids. The sum (0+1+...+7 = 28) is schedule-independent,
+// so the printed line is identical under graalgo and gc. This exercises
+// the same broadcast-wakeup path as context cancellation without importing
+// the context package (not yet executable through the product launcher on
+// the current base); see gmp_compute.go.
+//
+// The stress-differential script compares output byte-for-byte.
+func main() {
+	done := make(chan struct{})
+	ack := make(chan int, 8)
+	for w := 0; w < 8; w++ {
+		go func(w int) {
+			<-done
+			ack <- w
+		}(w)
+	}
+	close(done)
+	sum := 0
+	for w := 0; w < 8; w++ {
+		sum += <-ack
+	}
+	println("canceled", sum)
+}
diff --git a/tools/torture/corpus/gmp_compute.go b/tools/torture/corpus/gmp_compute.go
new file mode 100644
index 00000000..f04071f6
--- /dev/null
+++ b/tools/torture/corpus/gmp_compute.go
@@ -0,0 +1,33 @@
+package main
+
+// gmp_compute: deterministic parallel compute workload.
+//
+// Eight workers each sum the squares of their strided slice of 1..N; the
+// partial sums are added in a fixed order, so the printed total is
+// identical under any goroutine schedule and any GOMAXPROCS. The
+// gmp-matrix and stress-differential scripts compare graalgo's output
+// byte-for-byte against gc's.
+//
+// NOTE: output goes through the println builtin (stderr on both gc and
+// graalgo) because the fmt/os packages are not yet executable through the
+// product launcher on the current base (pre-existing toolchain gaps, not
+// script issues); see tools/torture/README.md.
+func main() {
+	const N = 200000
+	const workers = 8
+	ch := make(chan int64, workers)
+	for w := 0; w < workers; w++ {
+		go func(w int) {
+			var sum int64
+			for i := w + 1; i <= N; i += workers {
+				sum += int64(i) * int64(i)
+			}
+			ch <- sum
+		}(w)
+	}
+	var total int64
+	for w := 0; w < workers; w++ {
+		total += <-ch
+	}
+	println(total)
+}
diff --git a/tools/torture/corpus/gmp_mixed.go b/tools/torture/corpus/gmp_mixed.go
new file mode 100644
index 00000000..be3b3347
--- /dev/null
+++ b/tools/torture/corpus/gmp_mixed.go
@@ -0,0 +1,40 @@
+package main
+
+// gmp_mixed: deterministic mixed compute+communication workload.
+//
+// A producer feeds 1..N into a channel; four worker goroutines square each
+// value and forward it; the main goroutine sums the squares. Addition is
+// order-independent, so the printed total is identical under any schedule
+// and any GOMAXPROCS. The gmp-matrix and stress-differential scripts compare
+// graalgo's output byte-for-byte against gc's.
+//
+// NOTE: output goes through the println builtin (stderr on both gc and
+// graalgo); see gmp_compute.go for why fmt is not used.
+func main() {
+	const N = 5000
+	const workers = 4
+	in := make(chan int)
+	out := make(chan int)
+	for w := 0; w < workers; w++ {
+		go func() {
+			for {
+				v, ok := <-in
+				if !ok {
+					return
+				}
+				out <- v * v
+			}
+		}()
+	}
+	go func() {
+		for i := 1; i <= N; i++ {
+			in <- i
+		}
+		close(in)
+	}()
+	var total int64
+	for i := 0; i < N; i++ {
+		total += int64(<-out)
+	}
+	println(total)
+}
diff --git a/tools/torture/corpus/goroutine_storm.go b/tools/torture/corpus/goroutine_storm.go
new file mode 100644
index 00000000..f7933db6
--- /dev/null
+++ b/tools/torture/corpus/goroutine_storm.go
@@ -0,0 +1,35 @@
+package main
+
+// goroutine_storm: scheduler admission under a spawn burst.
+//
+// Spawns 500 goroutines; each does a small amount of compute, then signals
+// completion through a buffered channel. The main goroutine drains the
+// channel and prints the count. The count is deterministic (500); the gate
+// is clean completion (exit 0, no lost wakeup, no hang) on both graalgo
+// and gc — a scheduler-level stress the Java-side F6 leg also covers.
+//
+// (A finalizer storm would be the ideal runtime-pattern counterpart, but
+// runtime.SetFinalizer is not yet executable through the product launcher
+// on the current base; see gmp_compute.go.)
+//
+// The stress-differential script runs this in "completion" mode.
+func main() {
+	const N = 500
+	done := make(chan int, N)
+	for i := 0; i < N; i++ {
+		go func(i int) {
+			x := i
+			for k := 0; k < 100; k++ {
+				x = x*31 + k
+			}
+			_ = x
+			done <- i
+		}(i)
+	}
+	count := 0
+	for i := 0; i < N; i++ {
+		<-done
+		count++
+	}
+	println("done", count)
+}
