@@ -0,0 +1,155 @@
+package main
+
+// v2.0.0 no-synthetic-credit tests (rev1107-22-f1, REVIEW-2026-11-07-22
+// F1/F2): the synthetic-scan machinery and the synthetic provided-set
+// sources are deleted. These tests pin the removal — each one fails
+// against the v1.x code (which credited synthetic packages) and passes
+// only when no synthetic mechanism remains.
+//
+// Non-tautology design: each test asserts a specific mechanical fact
+// that flips if synthetic crediting comes back — a synthetic-only
+// symbol classifying MISSING, a JSON report with no synthetic fields,
+// a provided set whose every provenance is the intrinsic registry.
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+func TestNoSyntheticCredit(t *testing.T) {
+	provided, err := loadProvided(options{graalgo: graalgoRoot(t)})
+	if err != nil {
+		t.Fatalf("loadProvided: %v", err)
+	}
+	// Every provenance must be the P3-M4 intrinsic registry.
+	for sym, prov := range provided.Symbols {
+		if prov != "p3link LinknameIntrinsics.java Linknames.register" {
+			t.Errorf("symbol %q has non-registry provenance %q", sym, prov)
+		}
+	}
+	// No synthetic-only symbol may be provided, from any family.
+	for _, w := range []string{
+		"os.Open", "os.ReadFile", "os.Args",
+		"time.Now", "time.Sleep", "time.Time", "time.Duration",
+		"context.Background", "context.TODO",
+		"encoding/json.Marshal", "encoding/json.Unmarshal",
+		"crypto/sha256.New", "crypto/sha512.New",
+		"syscall.Getenv", "syscall.Exit",
+		"maps.Clone", "slices.Sort",
+		"strings.Builder", "bytes.Buffer",
+		"errors.New", "sort.Ints",
+		"internal/bytealg.MakeNoZero",
+	} {
+		if provided.has(w) {
+			t.Errorf("provided set credits synthetic-only symbol %q", w)
+		}
+	}
+	// Registry symbols in the graalgo.* namespaces stay provided —
+	// they are intrinsic registrations, not synthetic credit.
+	for _, w := range []string{
+		"graalgo.os.open", "graalgo.net.socket",
+		"graalgo.x509.parse", "graalgo.tls.newClientEngine",
+	} {
+		if !provided.has(w) {
+			t.Errorf("provided set missing registry symbol %q", w)
+		}
+	}
+}
+
+func TestReportHasNoSyntheticFields(t *testing.T) {
+	rep := fixtureReport(t)
+	data, err := json.Marshal(rep)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, banned := range []string{
+		"shadowed_by", "synthetic_", "live_refs", "live_skip_list_size",
+		"synthetic/",
+	} {
+		if strings.Contains(string(data), banned) {
+			t.Errorf("JSON report still contains %q", banned)
+		}
+	}
+	if rep.Version != "2.0.0" {
+		t.Errorf("report version = %q, want 2.0.0", rep.Version)
+	}
+	for _, e := range rep.Entries {
+		if strings.HasPrefix(e.File, "synthetic/") {
+			t.Errorf("report still contains a synthetic-source entry: %+v", e)
+		}
+	}
+}
+
+func TestSyntheticTargetIsMissing(t *testing.T) {
+	provided := &ProvidedSet{Symbols: map[string]string{
+		"runtime.fastrand": "p3link LinknameIntrinsics.java Linknames.register",
+	}}
+	scan := &ScanResult{}
+	scan.addFileDecls("runtime/runtime.go", []string{"a", "b", "c"})
+	scan.addFileDecls("syscall/syscall_linux.go", []string{"d"})
+	scan.Linknames = []Linkname{
+		// Previously SATISFIED via the synthetic syscall package:
+		// now MISSING with the intrinsic-surface reason.
+		{File: "syscall/syscall_linux.go", Package: "syscall", Local: "d", Declared: "d", Target: "syscall.Exit"},
+		// Registry-provided target: still SATISFIED.
+		{File: "runtime/runtime.go", Package: "runtime", Local: "a", Declared: "a", Target: "runtime.fastrand"},
+		// Self-link: SATISFIED by construction (no shadow concept
+		// any more — every self-link is a provision).
+		{File: "runtime/runtime.go", Package: "runtime", Local: "b", Declared: "b", SelfLink: true},
+		// Undeclared self-link: gc rejects, still MISSING.
+		{File: "runtime/runtime.go", Package: "runtime", Local: "other", Declared: "c", SelfLink: true},
+	}
+	rep := Classify(scan, provided, nil, options{})
+	byTarget := map[string]*Entry{}
+	for i := range rep.Entries {
+		byTarget[rep.Entries[i].Target] = &rep.Entries[i]
+	}
+	if e := byTarget["syscall.Exit"]; e == nil || e.Status != StatusMissing {
+		t.Fatalf("syscall.Exit: got %+v, want MISSING", e)
+	} else if !strings.Contains(e.Reason, "P3-M4 intrinsic surface") {
+		t.Errorf("syscall.Exit reason = %q, want the intrinsic-surface reason", e.Reason)
+	}
+	if e := byTarget["runtime.fastrand"]; e == nil || e.Status != StatusSatisfied {
+		t.Fatalf("runtime.fastrand: got %+v, want SATISFIED", e)
+	}
+	if e := byTarget["runtime.b"]; e == nil || e.Status != StatusSatisfied {
+		t.Fatalf("self-link runtime.b: got %+v, want SATISFIED", e)
+	} else if e.ProvidedFrom != "self" {
+		t.Errorf("self-link runtime.b: ProvidedFrom = %q, want %q", e.ProvidedFrom, "self")
+	}
+	if e := byTarget["runtime.other"]; e == nil || e.Status != StatusMissing {
+		t.Fatalf("undeclared self-link runtime.other: got %+v, want MISSING", e)
+	}
+	// Skip-list holds exactly the two MISSING targets (no live/total
+	// split: every skip-list entry is actionable).
+	if rep.SkipListSize != 2 {
+		t.Fatalf("SkipListSize = %d, want 2", rep.SkipListSize)
+	}
+	for _, s := range rep.SkipList {
+		if s.Target != "syscall.Exit" && s.Target != "runtime.other" {
+			t.Fatalf("unexpected skip-list target %q", s.Target)
+		}
+	}
+}
