+package main
+
+import (
+	"strings"
+	"testing"
+)
+
+// TestSyntheticOsFileReadFromWriteToDesugar (R-1107-05): the P0-2 named
+// traps in __fileReadFrom/__fileWriteTo carried the re-test trigger
+// "mrM8 desugar for io.ReadAll / io.WriteString". Both callees are now
+// in the m8 desugar table (mrdesugar_m5.go) with real helpers
+// (__readAll, __writeString), so the trigger is met and the helpers must
+// be real implementations, not panics. The exported ReadFrom/WriteTo
+// methods keep their panic bodies: those are the fail-fast for
+// non-2-target call positions, unchanged by this fix.
+//
+// Red-green: pre-fix, the wire contains the P0-2 trap strings and the
+// __fileReadFrom/__fileWriteTo funcdecl bodies are a single panic (no
+// call to __readAll / __writeString); post-fix, the traps are gone and
+// the bodies call the real helpers (the desugar fires inside the helper
+// bodies, as it already does for io.ReadAll/io.WriteString in
+// synth_archive_tar.go / synth_archive_zip.go).
+func TestSyntheticOsFileReadFromWriteToDesugar(t *testing.T) {
+	src := `package main
+
+import (
+	"bytes"
+	"os"
+)
+
+func main() {
+	f, _ := os.CreateTemp("", "r1107-05-*")
+	defer os.Remove(f.Name())
+	defer f.Close()
+	n, _ := f.ReadFrom(bytes.NewReader([]byte("hi")))
+	println(n)
+	m, _ := f.WriteTo(bytes.NewBuffer(nil))
+	println(m)
+}
+`
+	out := mustExport(t, src)
+	for _, trap := range []string{
+		"multi-result io.ReadAll needs the mrM8 desugar",
+		"multi-result io.WriteString needs the mrM8 desugar",
+	} {
+		if strings.Contains(out, trap) {
+			t.Fatalf("wire still contains the P0-2 trap %q", trap)
+		}
+	}
+	doc := decodeExport(t, out)
+	readFrom := osFuncDecl(t, doc, "os", "__fileReadFrom")
+	if !wireBodyCallsHelper(t, readFrom["body"], "__readAll") {
+		t.Fatal("__fileReadFrom body has no call to __readAll (desugar did not fire inside the helper)")
+	}
+	writeTo := osFuncDecl(t, doc, "os", "__fileWriteTo")
+	if !wireBodyCallsHelper(t, writeTo["body"], "__writeString") {
+		t.Fatal("__fileWriteTo body has no call to __writeString (desugar did not fire inside the helper)")
+	}
+}
+
+// osFuncDecl returns the wire funcdecl named name in package pkgpath,
+// or fails the test.
+func osFuncDecl(t *testing.T, doc map[string]any, pkgpath, name string) map[string]any {
+	t.Helper()
+	for _, f := range findAllKind(doc, "funcdecl") {
+		fl, _ := f["fields"].(map[string]any)
+		if fl["name"] == name && fl["pkgpath"] == pkgpath {
+			return fl
+		}
+	}
+	t.Fatalf("no funcdecl %s in package %s", name, pkgpath)
+	return nil
+}
+
+// wireBodyCallsHelper reports whether the funcdecl body contains a call
+// whose function is the bare identifier helper (the desugar's
+// single-result __-helper call shape).
+func wireBodyCallsHelper(t *testing.T, body any, helper string) bool {
+	t.Helper()
+	found := false
+	var seen []string
+	var walk func(n any)
+	walk = func(n any) {
+		switch v := n.(type) {
+		case map[string]any:
+			if v["kind"] == "call" {
+				if fun, ok := v["fields"].(map[string]any)["fun"].(map[string]any); ok {
+					if fun["kind"] == "ident" {
+						if name, _ := fun["fields"].(map[string]any)["name"].(string); name != "" {
+							seen = append(seen, name)
+							if name == helper {
+								found = true
+							}
+						}
+					}
+				}
+			}
+			for _, c := range v {
+				walk(c)
+			}
+		case []any:
+			for _, c := range v {
+				walk(c)
+			}
+		}
+	}
+	walk(body)
+	if !found {
+		t.Logf("call fun idents seen in body: %v", seen)
+	}
+	return found
+}
