+// R20-F03: the importing module's go.mod pins govern module-cache version
+// selection. gofrontend is a single-shot process (one ExportFiles call per
+// invocation; see main.go), so the anchor is process-global state set once
+// at ExportFiles entry from importingDir (the input files' directory, or
+// the --test-package-dir override). The disk caches are memo tables for
+// that anchor: changing the anchor clears them, so sequential in-process
+// ExportFiles calls (tests) with different main modules can never observe
+// a stale version. This package has no t.Parallel tests (verified
+// 2026-11-07), so no concurrent-anchor hazard exists.
+var (
+	diskAnchorDir  string
+	diskPins       goModPins
+	diskPinsAnchor string // anchor dir diskPins was parsed from; "" = not yet parsed
+)
+
+// goModPins is the subset of a main module's go.mod that governs disk
+// import version selection: require directives and replace directives.
+// Only the main module's file is read (full MVS over the module graph is
+// out of scope; see the resolveDiskPackageDir comment). Parsed without
+// golang.org/x/mod: this module has no dependencies, and the grammar
+// needed here (require/replace, single-line and block forms) is small.
+type goModPins struct {
+	require map[string]string // module path -> pinned version
+	replace map[string]string // module path -> "version:<v>" or "path:<local dir>"
+	root    string            // directory of the go.mod the pins came from
+}
+
+// parseGoModPins extracts require/replace directives from go.mod data.
+// Single-line and block forms, trailing // comments, and `// indirect`
+// markers are handled; module/go/exclude/retract/toolchain lines are
+// ignored. A replace with a version overrides require for that module; a
+// replace with a local path overrides both.
+func parseGoModPins(data []byte) goModPins {
+	p := goModPins{require: map[string]string{}, replace: map[string]string{}}
+	var block string // "" or "require" or "replace"
+	for _, raw := range strings.Split(string(data), "\n") {
+		// go.mod has no quoted strings, so the first "//" always starts
+		// a comment.
+		if i := strings.Index(raw, "//"); i >= 0 {
+			raw = raw[:i]
+		}
+		line := strings.TrimSpace(raw)
+		if line == "" {
+			continue
+		}
+		if block != "" {
+			if line == ")" {
+				block = ""
+				continue
+			}
+			addPinLine(&p, block, line)
+			continue
+		}
+		fields := strings.Fields(line)
+		switch fields[0] {
+		case "require", "replace":
+			if fields[len(fields)-1] == "(" {
+				block = fields[0]
+				continue
+			}
+			addPinLine(&p, fields[0], line)
+		}
+	}
+	return p
+}
+
+// addPinLine records one require/replace directive line. block is
+// "require" or "replace". Both the keyword-prefixed single-line form
+// ("require m v") and the bare block form ("m v") are accepted.
+func addPinLine(p *goModPins, block, line string) {
+	fields := strings.Fields(line)
+	if len(fields) > 0 && (fields[0] == "require" || fields[0] == "replace") {
+		fields = fields[1:]
+	}
+	if block == "require" {
+		if len(fields) >= 2 {
+			p.require[fields[0]] = fields[1]
+		}
+		return
+	}
+	// replace: "old [oldver] => new [newver]" or "old [oldver] => ../local".
+	arrow := -1
+	for i, f := range fields {
+		if f == "=>" {
+			arrow = i
+			break
+		}
+	}
+	if arrow < 1 || arrow+1 >= len(fields) {
+		return
+	}
+	old := fields[0]
+	if len(fields[arrow+1:]) >= 2 {
+		// "=> module version": the replacement version governs.
+		p.replace[old] = "version:" + fields[arrow+2]
+	} else if target := fields[arrow+1]; strings.HasPrefix(target, ".") || filepath.IsAbs(target) {
+		// "=> ../local": a filesystem path (relative to the go.mod dir).
+		// A bare single token that is not a path (e.g. "=> example.com/x"
+		// with no version) is invalid go.mod; ignore the directive and
+		// let require govern rather than misreading a module as a path.
+		p.replace[old] = "path:" + target
+	}
+}
+
+// findMainModuleGoMod walks up from anchorDir to the nearest go.mod and
+// returns its directory and contents. Same walk as p3frontend's
+// findModule (which reads only the module line); this one returns the
+// whole file so require/replace directives can be parsed. A missing
+// go.mod is not an error: GOPATH-mode programs have no pins.
+func findMainModuleGoMod(anchorDir string) (root string, data []byte, ok bool) {
+	abs, err := filepath.Abs(anchorDir)
+	if err != nil {
+		abs = anchorDir
+	}
+	for d := abs; ; d = filepath.Dir(d) {
+		if content, err := os.ReadFile(filepath.Join(d, "go.mod")); err == nil {
+			return d, content, true
+		}
+		parent := filepath.Dir(d)
+		if parent == d {
+			return "", nil, false
+		}
+	}
+}
+
+// setDiskAnchor records the importing package's directory for this
+// ExportFiles invocation (see importingDir) and invalidates the disk
+// caches when it changes: a resolved directory is only valid for the
+// main module whose go.mod pins selected it. Called once per ExportFiles
+// call; the anchor is constant for the whole export, including recursive
+// disk imports — the MAIN module's pins govern the build, exactly as the
+// main module's require set seeds gc's build list.
+func setDiskAnchor(dir string) {
+	diskMu.Lock()
+	defer diskMu.Unlock()
+	if dir == diskAnchorDir {
+		return
+	}
+	diskAnchorDir = dir
+	diskPinsAnchor = ""
+	diskPins = goModPins{}
+	diskCache = map[string]*syntheticPackage{}
+	diskDirCache = map[string]string{}
+	diskBuilding = map[string]bool{}
+}
+
+// pinsForAnchor returns the parsed require/replace directives of the main
+// module enclosing the anchor directory, parsed once per anchor. Empty
+// when no go.mod encloses the anchor (GOPATH mode) or it has no
+// directives: callers then fall back to the legacy highest-version
+// selection.
+func pinsForAnchor() goModPins {
+	diskMu.Lock()
+	defer diskMu.Unlock()
+	if diskAnchorDir == "" || diskPinsAnchor == diskAnchorDir {
+		return diskPins
+	}
+	diskPinsAnchor = diskAnchorDir
+	if root, data, ok := findMainModuleGoMod(diskAnchorDir); ok {
+		diskPins = parseGoModPins(data)
+		diskPins.root = root
+	} else {
+		diskPins = goModPins{}
+	}
+	return diskPins
+}
+
+// pinResolution is the outcome of consulting the main module's go.mod
+// pins for one module path.
+type pinResolution struct {
+	pinned  bool   // a require/replace directive names this module
+	version string // pinned version ("" when replaced by a local path)
+	local   string // local replacement directory, "" when version-pinned
+}
+
+// pinnedModuleVersion consults pins for modulePath. A replace with a
+// version overrides require; a replace with a local path overrides both.
+// ok=false: no directive names this module.
+func pinnedModuleVersion(modulePath string, pins goModPins) (pinResolution, bool) {
+	if rep, ok := pins.replace[modulePath]; ok {
+		if v, ok := strings.CutPrefix(rep, "version:"); ok {
+			return pinResolution{pinned: true, version: v}, true
+		}
+		if p, ok := strings.CutPrefix(rep, "path:"); ok {
+			local := p
+			if !filepath.IsAbs(local) {
+				local = filepath.Join(pins.root, local)
+			}
+			return pinResolution{pinned: true, local: local}, true
+		}
+	}
+	if v, ok := pins.require[modulePath]; ok {
+		return pinResolution{pinned: true, version: v}, true
+	}
+	return pinResolution{}, false
+}
