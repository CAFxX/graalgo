+func TestParseGoModPins(t *testing.T) {
+	pins := parseGoModPins([]byte(`module example.com/main
+
+go 1.21
+
+require (
+	example.com/a v1.2.3 // indirect
+	example.com/mod v1.3.0
+)
+
+require example.com/single v0.9.0
+
+replace example.com/mod => example.com/mod v1.2.0
+
+replace (
+	example.com/old v1.0.0 => example.com/new v2.0.0
+	example.com/local => ../local
+)
+`))
+	if pins.require["example.com/mod"] != "v1.3.0" {
+		t.Fatalf("block require: got %q, want v1.3.0", pins.require["example.com/mod"])
+	}
+	if pins.require["example.com/a"] != "v1.2.3" {
+		t.Fatalf("indirect require: got %q, want v1.2.3", pins.require["example.com/a"])
+	}
+	if pins.require["example.com/single"] != "v0.9.0" {
+		t.Fatalf("single-line require: got %q, want v0.9.0", pins.require["example.com/single"])
+	}
+	if pins.replace["example.com/mod"] != "version:v1.2.0" {
+		t.Fatalf("replace version: got %q, want version:v1.2.0", pins.replace["example.com/mod"])
+	}
+	if pins.replace["example.com/old"] != "version:v2.0.0" {
+		t.Fatalf("block replace version: got %q, want version:v2.0.0", pins.replace["example.com/old"])
+	}
+	if pins.replace["example.com/local"] != "path:../local" {
+		t.Fatalf("block replace path: got %q, want path:../local", pins.replace["example.com/local"])
+	}
+	empty := parseGoModPins([]byte("module example.com/main\n\ngo 1.21\n"))
+	if len(empty.require) != 0 || len(empty.replace) != 0 {
+		t.Fatalf("no-directive go.mod produced pins: %+v", empty)
+	}
+}
