+func TestDiskImportAnchorChangeClearsCache(t *testing.T) {
+	// Resolving under a no-pin anchor caches the highest version; moving
+	// the anchor to a pinning module must not observe the stale entry.
+	cache := pinnedFixture(t)
+	t.Setenv("GOMODCACHE", cache)
+	plainDir := t.TempDir()
+	p := filepath.Join(plainDir, "main.go")
+	if err := os.WriteFile(p, []byte("package main\n\nfunc main() {}\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	setDiskAnchor(plainDir)
+	t.Cleanup(func() { setDiskAnchor("") })
+	dir, err := resolveDiskPackageDir("example.com/mod")
+	if err != nil {
+		t.Fatalf("resolveDiskPackageDir (plain): %v", err)
+	}
+	if !strings.HasSuffix(dir, "mod@v1.6.0") {
+		t.Fatalf("plain anchor resolved to %s, want mod@v1.6.0", dir)
+	}
+	pinDir := t.TempDir()
+	writeMainModule(t, pinDir,
+		"module example.com/main\n\ngo 1.21\n\nrequire example.com/mod v1.3.0\n",
+		"package main\n\nimport _ \"example.com/mod\"\n\nfunc main() {}\n")
+	setDiskAnchor(pinDir)
+	dir, err = resolveDiskPackageDir("example.com/mod")
+	if err != nil {
+		t.Fatalf("resolveDiskPackageDir (pinned): %v", err)
+	}
+	if !strings.HasSuffix(dir, "mod@v1.3.0") {
+		t.Fatalf("pinned anchor resolved to %s, want mod@v1.3.0 (stale cache?)", dir)
+	}
+}
