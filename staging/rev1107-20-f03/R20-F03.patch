+func TestDiskImportPinMissingEndToEnd(t *testing.T) {
+	// Pinned version absent from the cache: the export fails LOUDLY with
+	// the pinned version named (not a generic scope error, not a silent
+	// substitution). The overlay importer propagates non-errDiskNotFound
+	// errors verbatim (export.go overlayImporter.Import).
+	cache := t.TempDir()
+	writeFakeModule(t, cache, "example.com/mod", "v1.6.0", map[string]string{
+		"mod.go": "package mod\n\nconst Version = \"v1.6.0\"\n",
