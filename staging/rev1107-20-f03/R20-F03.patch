+package main
+
+// R20-F03: disk import honors the importing module's go.mod pins.
+//
+// A third-party import used to resolve to $GOMODCACHE/<path>@<highest
+// version> regardless of what the importing program's go.mod pinned.
+// These tests pin the cache with two versions of a fake module and assert
+// the pinned version is selected, a missing pinned version fails loudly,
+// and the legacy highest-version fallback survives where no pin applies.
+//
+// RED note: the two end-to-end tests compile against the PRE-FIX code
+// (they only use ExportFiles) and fail there — v1.6.0 selected / no error
+// — so they are genuine behavioral RED tests. The unit tests use the new
+// setDiskAnchor API and therefore do not compile pre-fix; their RED proof
+// is the standalone harness (harness/main.go), which runs the OLD rule
+// (highest version) against the NEW rule on the same fixtures. The
+// no-pin test passes pre- and post-fix and guards the unchanged fallback.
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+// writeFakeModule writes files into a fake module-cache entry
+// $GOMODCACHE/<escaped module>@<version>/, creating parent dirs.
+func writeFakeModule(t *testing.T, cache, module, version string, files map[string]string) {
+	t.Helper()
+	dir := filepath.Join(cache, escapeModulePath(module)+"@"+version)
+	for rel, src := range files {
+		p := filepath.Join(dir, filepath.FromSlash(rel))
+		if err := os.MkdirAll(filepath.Dir(p), 0o755); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(p, []byte(src), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
+
+// writeMainModule writes go.mod + main.go into dir and returns main.go's path.
+func writeMainModule(t *testing.T, dir, goMod, mainGo string) string {
+	t.Helper()
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, "go.mod"), []byte(goMod), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	p := filepath.Join(dir, "main.go")
+	if err := os.WriteFile(p, []byte(mainGo), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	return p
+}
+
+// pinnedFixture builds a fake cache with example.com/mod at v1.3.0 and
+// v1.6.0 (each a one-file package exposing its version) and returns the
+// cache dir. The caller sets GOMODCACHE to it.
+func pinnedFixture(t *testing.T) string {
+	t.Helper()
+	cache := t.TempDir()
+	writeFakeModule(t, cache, "example.com/mod", "v1.3.0", map[string]string{
+		"mod.go": "package mod\n\nconst Version = \"v1.3.0\"\n",
+	})
+	writeFakeModule(t, cache, "example.com/mod", "v1.6.0", map[string]string{
+		"mod.go": "package mod\n\nconst Version = \"v1.6.0\"\n",
+	})
+	return cache
+}
+
+// resolveWithAnchor is resolveDiskPackageDir with the anchor set to dir,
+// resetting global disk state afterwards.
+func resolveWithAnchor(t *testing.T, dir, importPath string) (string, error) {
+	t.Helper()
+	setDiskAnchor(dir)
+	t.Cleanup(func() { setDiskAnchor("") })
+	return resolveDiskPackageDir(importPath)
+}
+
+func TestDiskImportHonorsGoModPin(t *testing.T) {
+	cache := pinnedFixture(t)
+	t.Setenv("GOMODCACHE", cache)
+	mainDir := t.TempDir()
+	writeMainModule(t, mainDir,
+		"module example.com/main\n\ngo 1.21\n\nrequire example.com/mod v1.3.0\n",
+		"package main\n\nimport _ \"example.com/mod\"\n\nfunc main() {}\n")
+	dir, err := resolveWithAnchor(t, mainDir, "example.com/mod")
+	if err != nil {
+		t.Fatalf("resolveDiskPackageDir: %v", err)
+	}
+	want := filepath.Join(cache, "example.com", "mod@v1.3.0")
+	if dir != want {
+		t.Fatalf("resolved to %s, want pinned %s", dir, want)
+	}
+}
+
+func TestDiskImportPinMissingVersionFailsLoud(t *testing.T) {
+	cache := t.TempDir()
+	writeFakeModule(t, cache, "example.com/mod", "v1.6.0", map[string]string{
+		"mod.go": "package mod\n\nconst Version = \"v1.6.0\"\n",
+	})
+	t.Setenv("GOMODCACHE", cache)
+	mainDir := t.TempDir()
+	writeMainModule(t, mainDir,
+		"module example.com/main\n\ngo 1.21\n\nrequire example.com/mod v1.3.0\n",
+		"package main\n\nimport _ \"example.com/mod\"\n\nfunc main() {}\n")
+	_, err := resolveWithAnchor(t, mainDir, "example.com/mod")
+	if err == nil {
+		t.Fatal("expected a loud error for a pinned version absent from the cache, got nil")
+	}
+	for _, want := range []string{"v1.3.0", "go.mod requires", "has only"} {
+		if !strings.Contains(err.Error(), want) {
+			t.Fatalf("error %q does not mention %q", err.Error(), want)
+		}
+	}
+}
+
+func TestDiskImportNoPinTakesHighest(t *testing.T) {
+	// No go.mod encloses the importing package: legacy highest-version
+	// selection is preserved (GOPATH mode / unpinned modules).
+	cache := pinnedFixture(t)
+	t.Setenv("GOMODCACHE", cache)
+	mainDir := t.TempDir()
+	p := filepath.Join(mainDir, "main.go")
+	if err := os.WriteFile(p, []byte("package main\n\nfunc main() {}\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	dir, err := resolveWithAnchor(t, mainDir, "example.com/mod")
+	if err != nil {
+		t.Fatalf("resolveDiskPackageDir: %v", err)
+	}
+	want := filepath.Join(cache, "example.com", "mod@v1.6.0")
+	if dir != want {
+		t.Fatalf("resolved to %s, want legacy highest %s", dir, want)
+	}
+}
+
+func TestDiskImportPinSubpackage(t *testing.T) {
+	cache := t.TempDir()
+	writeFakeModule(t, cache, "example.com/mod", "v1.3.0", map[string]string{
+		"sub/sub.go": "package sub\n\nconst Version = \"v1.3.0\"\n",
+	})
+	writeFakeModule(t, cache, "example.com/mod", "v1.6.0", map[string]string{
+		"sub/sub.go": "package sub\n\nconst Version = \"v1.6.0\"\n",
+	})
+	t.Setenv("GOMODCACHE", cache)
+	mainDir := t.TempDir()
+	writeMainModule(t, mainDir,
+		"module example.com/main\n\ngo 1.21\n\nrequire example.com/mod v1.3.0\n",
+		"package main\n\nimport _ \"example.com/mod/sub\"\n\nfunc main() {}\n")
+	dir, err := resolveWithAnchor(t, mainDir, "example.com/mod/sub")
+	if err != nil {
+		t.Fatalf("resolveDiskPackageDir: %v", err)
+	}
+	want := filepath.Join(cache, "example.com", "mod@v1.3.0", "sub")
+	if dir != want {
+		t.Fatalf("resolved to %s, want pinned %s", dir, want)
+	}
+}
+
+func TestDiskImportReplaceVersionOverridesRequire(t *testing.T) {
+	cache := pinnedFixture(t)
+	t.Setenv("GOMODCACHE", cache)
+	mainDir := t.TempDir()
+	writeMainModule(t, mainDir,
+		"module example.com/main\n\ngo 1.21\n\nrequire example.com/mod v1.6.0\n\nreplace example.com/mod => example.com/mod v1.3.0\n",
+		"package main\n\nimport _ \"example.com/mod\"\n\nfunc main() {}\n")
+	dir, err := resolveWithAnchor(t, mainDir, "example.com/mod")
+	if err != nil {
+		t.Fatalf("resolveDiskPackageDir: %v", err)
+	}
+	want := filepath.Join(cache, "example.com", "mod@v1.3.0")
+	if dir != want {
+		t.Fatalf("resolved to %s, want replace-pinned %s", dir, want)
+	}
+}
+
+func TestDiskImportReplaceLocalPath(t *testing.T) {
+	cache := pinnedFixture(t)
+	t.Setenv("GOMODCACHE", cache)
+	mainDir := t.TempDir()
+	local := filepath.Join(mainDir, "localmod")
+	if err := os.MkdirAll(local, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(local, "mod.go"), []byte("package mod\n\nconst Version = \"local\"\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	writeMainModule(t, mainDir,
+		"module example.com/main\n\ngo 1.21\n\nrequire example.com/mod v1.6.0\n\nreplace example.com/mod => ./localmod\n",
+		"package main\n\nimport _ \"example.com/mod\"\n\nfunc main() {}\n")
+	dir, err := resolveWithAnchor(t, mainDir, "example.com/mod")
+	if err != nil {
+		t.Fatalf("resolveDiskPackageDir: %v", err)
+	}
+	if dir != local {
+		t.Fatalf("resolved to %s, want local replacement %s", dir, local)
+	}
+}
+
+func TestDiskImportReplaceLocalPathMissingFailsLoud(t *testing.T) {
+	cache := pinnedFixture(t)
+	t.Setenv("GOMODCACHE", cache)
+	mainDir := t.TempDir()
+	writeMainModule(t, mainDir,
+		"module example.com/main\n\ngo 1.21\n\nrequire example.com/mod v1.6.0\n\nreplace example.com/mod => ./nolocalmod\n",
+		"package main\n\nimport _ \"example.com/mod\"\n\nfunc main() {}\n")
+	_, err := resolveWithAnchor(t, mainDir, "example.com/mod")
+	if err == nil {
+		t.Fatal("expected a loud error for a missing local replacement, got nil")
+	}
+	if !strings.Contains(err.Error(), "nolocalmod") {
+		t.Fatalf("error %q does not name the missing replacement", err.Error())
+	}
+}
