+// TestEmitBinaryRunsRealBackend executes a real artifact end to end under
+// the real graalgo backend (graalgo-sync-run), asserting the program runs
+// and prints its output. Unlike TestEmitBinaryRuns (fake backend script),
+// this catches arg-form mismatches the backend rejects: the launcher used
+// to pass "--wire-input <file>" (space form) while the backend accepts
+// only "--wire-input=<file>", so every artifact failed at startup with
+// "unknown flag: --wire-input" (NEW-P0-1).
+//
+// It runs only when the real backend is present: it skips in short mode
+// and when graalgo-sync-run, the compiled backend classes, gofrontend, or
+// the GraalVM java are missing. The graalgo root defaults to the repo root
+// derived from this test file's path; override it with
+// GRAALGO_TEST_REAL_BACKEND_ROOT. Override gofrontend with
+// GRAALGO_GOFRONTEND.
+//
+// The program is deliberately minimal (builtin println, no imports): its
+// wire JSON is ~3KB, so the test stays fast and low-memory. A fmt program
+// pulls in the whole fmt tree (~113MB of wire JSON) and is covered by the
+// differential suite instead; what this test pins is the launcher/backend
+// arg contract, not fmt support.
+func TestEmitBinaryRunsRealBackend(t *testing.T) {
+	if testing.Short() {
+		t.Skip("skipping real-backend execution test in short mode")
+	}
+	root, gofrontend := realBackendPrereqs(t)
+
+	tmpDir := t.TempDir()
+	jvmTmp := filepath.Join(tmpDir, "jvmtmp")
+	if err := os.MkdirAll(jvmTmp, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	// Builtin println (no imports): the program's output goes to
+	// stderr, matching gc.
+	hello := filepath.Join(tmpDir, "hello.go")
+	if err := os.WriteFile(hello, []byte("package main\n\nfunc main() { println(\"hello real-backend\") }\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	// Capture the real frontend output via the backend's --emit-wire,
+	// exactly as `graalgo build` does (cmd/graalgo/commands.go).
+	wirePath := filepath.Join(tmpDir, "wire.json")
+	runner := filepath.Join(root, "internal", "backend", "graalgo-sync-run")
+	emitCtx, emitCancel := context.WithTimeout(context.Background(), 5*time.Minute)
+	defer emitCancel()
+	emitCmd := exec.CommandContext(emitCtx, runner, "--emit-wire="+wirePath, "--check", hello)
+	emitCmd.Dir = tmpDir
+	emitCmd.Env = append(os.Environ(),
+		"GRAALGO_HOME="+root,
+		"GRAALGO_GOFRONTEND="+gofrontend,
+		"TMPDIR="+jvmTmp,
+	)
+	var emitOut bytes.Buffer
+	emitCmd.Stdout = &emitOut
+	emitCmd.Stderr = &emitOut
+	if err := emitCmd.Run(); err != nil {
+		t.Fatalf("backend --emit-wire failed: %v\n%s", err, emitOut.String())
+	}
+	wireJSON, err := os.ReadFile(wirePath)
+	if err != nil {
+		t.Fatalf("cannot read emitted wire JSON: %v", err)
+	}
+	if len(wireJSON) == 0 {
+		t.Fatalf("emitted wire JSON is empty")
+	}
+
+	out := filepath.Join(tmpDir, "prog")
+	if err := Emit(Artifact{
+		OutputPath:  out,
+		GraalgoRoot: root,
+		WireJSON:    wireJSON,
+	}); err != nil {
+		t.Fatalf("Emit: %v", err)
+	}
+
+	// Run the artifact under the real backend and assert the program's
+	// own output — this is what the fake-backend test cannot check.
+	runCtx, runCancel := context.WithTimeout(context.Background(), 5*time.Minute)
+	defer runCancel()
+	runCmd := exec.CommandContext(runCtx, out)
+	runCmd.Env = append(os.Environ(),
+		"GRAALGO_HOME="+root,
+		"TMPDIR="+jvmTmp,
+	)
+	var stdout, stderr bytes.Buffer
+	runCmd.Stdout = &stdout
+	runCmd.Stderr = &stderr
+	if err := runCmd.Run(); err != nil {
+		t.Fatalf("artifact run failed: %v\nstdout: %s\nstderr: %s", err, stdout.String(), stderr.String())
+	}
+	// println writes to stderr (gc parity); stdout must stay empty.
+	if got := stdout.String(); got != "" {
+		t.Errorf("artifact stdout = %q, want empty (println goes to stderr)", got)
+	}
+	if got := stderr.String(); !strings.Contains(got, "hello real-backend\n") {
+		t.Errorf("artifact stderr = %q, want it to contain %q", got, "hello real-backend\n")
+	}
+}
