+package graalgo.p3sync.launcher;
+
+import java.io.ByteArrayOutputStream;
+import java.io.PrintStream;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+
+/**
+ * End-to-end tests for the {@code --wire-input} execution path (Phase 4
+ * build artifacts): a {@code graalgo build} artifact feeds pre-generated
+ * frontend JSON to the backend, which must run it without input files.
+ *
+ * <p>verifies: NEW-P0-1 — {@code graalgo build} artifacts could not run at
+ * all. The launcher passed {@code --wire-input <file>} (space form) while
+ * the backend accepts only {@code --wire-input=<file>}; past that, the
+ * backend routed the launcher's post-{@code --} argv[0] into {@code files}
+ * (tripping the "--wire-input cannot be combined with input files"
+ * rejection), built zero Truffle Sources (NodeFactory threw "requires at
+ * least one Source"), and read argv[0] from the empty file list. All four
+ * breaks lived on this one never-exercised path (04c62c56); these tests
+ * pin the whole path through the real {@code P3SyncMain}.
+ *
+ * <p>These tests shell out to the real {@code gofrontend} binary (like the
+ * corpus runners and {@link LinknameEndToEndTest}); the wire JSON is
+ * captured with {@code --emit-wire} exactly as {@code graalgo build} does.
+ */
+public final class WireInputLauncherTest {
+
+    private static final String HELLO_PROG =
+            "package main\n\nfunc main() { println(\"hello real-backend\") }\n";
+
+    private static final String ARGS_PROG =
+            "package main\n\nimport \"os\"\n\nfunc main() {\n"
+            + "\tfor _, a := range os.Args {\n\t\tprintln(a)\n\t}\n}\n";
+
+    private static void assertTrue(boolean cond, String msg) {
+        if (!cond) {
+            throw new AssertionError(msg);
+        }
+    }
+
+    private static Path writeTempGo(String name, String src) throws Exception {
+        Path dir = Files.createTempDirectory("graalgo-wireinput-test");
+        Path f = dir.resolve(name);
+        Files.writeString(f, src, StandardCharsets.UTF_8);
+        return f;
+    }
+
+    /** Runs P3SyncMain with the given argv, capturing stdout+stderr. */
+    private static RunResult runMain(String[] argv) {
+        PrintStream oldOut = System.out;
+        PrintStream oldErr = System.err;
+        ByteArrayOutputStream outBuf = new ByteArrayOutputStream();
+        ByteArrayOutputStream errBuf = new ByteArrayOutputStream();
+        System.setOut(new PrintStream(outBuf, true, StandardCharsets.UTF_8));
+        System.setErr(new PrintStream(errBuf, true, StandardCharsets.UTF_8));
+        int code;
+        try {
+            code = P3SyncMain.run(argv);
+        } finally {
+            System.setOut(oldOut);
+            System.setErr(oldErr);
+        }
+        return new RunResult(code, outBuf.toString(StandardCharsets.UTF_8),
+                errBuf.toString(StandardCharsets.UTF_8));
+    }
+
+    private record RunResult(int exit, String stdout, String stderr) {}
+
+    /**
+     * Captures the frontend JSON for a program with --emit-wire, exactly as
+     * `graalgo build` does. Returns the wire file (non-empty on success).
+     */
+    private static Path emitWire(Path goFile) throws Exception {
+        Path wire = goFile.getParent().resolve("wire.json");
+        RunResult r = runMain(new String[] {
+            "--emit-wire=" + wire, "--check", goFile.toString()});
+        assertTrue(r.exit() == 0,
+                "--emit-wire failed, exit=" + r.exit() + "; stderr: " + r.stderr());
+        assertTrue(Files.size(wire) > 0, "emitted wire JSON is empty");
+        return wire;
+    }
+
+    /**
+     * verifies: NEW-P0-1 — a program fed via --wire-input runs and prints
+     * its output. Failed before the fix at arg parsing ("unknown flag:
+     * --wire-input" for the space form; "--wire-input cannot be combined
+     * with input files" once the form was fixed), then in NodeFactory
+     * ("requires at least one Source").
+     */
+    public void testWireInputRunsProgram() throws Exception {
+        Path go = writeTempGo("hello.go", HELLO_PROG);
+        Path wire = emitWire(go);
+        // The artifact's argv: --wire-input=<file> -- <argv0> [user args].
+        RunResult r = runMain(new String[] {
+            "--wire-input=" + wire, "--", "/tmp/fake-artifact"});
+        assertTrue(r.exit() == 0,
+                "expected exit 0, got " + r.exit() + "; stderr: " + r.stderr());
+        assertTrue(r.stdout().isEmpty(),
+                "expected empty stdout (println goes to stderr), got <" + r.stdout() + ">");
+        assertTrue(r.stderr().contains("hello real-backend\n"),
+                "expected stderr to contain 'hello real-backend', got <" + r.stderr() + ">");
+    }
+
+    /**
+     * verifies: NEW-P0-1 — in --wire-input mode the first token after "--"
+     * is the program's argv[0] and the rest are its arguments (os.Args),
+     * not input files. Failed before the fix with the "--wire-input cannot
+     * be combined with input files" rejection.
+     */
+    public void testWireInputForwardsArgv() throws Exception {
+        Path go = writeTempGo("args.go", ARGS_PROG);
+        Path wire = emitWire(go);
+        RunResult r = runMain(new String[] {
+            "--wire-input=" + wire, "--", "/tmp/fake-artifact", "hello", "world"});
+        assertTrue(r.exit() == 0,
+                "expected exit 0, got " + r.exit() + "; stderr: " + r.stderr());
+        String expected = "/tmp/fake-artifact\nhello\nworld\n";
+        assertTrue(r.stderr().equals(expected),
+                "expected os.Args lines <" + expected + ">, got <" + r.stderr() + ">");
+    }
+}
