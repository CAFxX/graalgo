+// realBackendPrereqs locates a runnable real backend for
+// TestEmitBinaryRunsRealBackend, skipping the test when any prerequisite
+// is missing. It returns the graalgo root and the gofrontend binary.
+func realBackendPrereqs(t *testing.T) (root, gofrontend string) {
+	t.Helper()
+	root = os.Getenv("GRAALGO_TEST_REAL_BACKEND_ROOT")
+	if root == "" {
+		_, file, _, ok := runtime.Caller(0)
+		if !ok {
+			t.Skip("cannot locate test file for repo-root discovery")
+		}
+		// This file lives at <root>/internal/driver/.
+		root = filepath.Dir(filepath.Dir(filepath.Dir(file)))
+	}
+	runner := filepath.Join(root, "internal", "backend", "graalgo-sync-run")
+	if fi, err := os.Stat(runner); err != nil || fi.Mode()&0o111 == 0 {
+		t.Skipf("real backend not built: %s missing or not executable (run make build)", runner)
+	}
+	classes := filepath.Join(root, "internal", "backend", "interop", "out", "classes")
+	if fi, err := os.Stat(classes); err != nil || !fi.IsDir() {
+		t.Skipf("real backend classes not built: %s missing (run make build)", classes)
+	}
+	java := ""
+	if graalvm := os.Getenv("GRAALVM_HOME"); graalvm != "" {
+		java = filepath.Join(graalvm, "bin", "java")
+	} else if home, err := os.UserHomeDir(); err == nil {
+		java = filepath.Join(home, "tools", "graalvm-jdk-25", "bin", "java")
+	}
+	if fi, err := os.Stat(java); err != nil || fi.Mode()&0o111 == 0 {
+		t.Skipf("GraalVM java not found at %s (set GRAALVM_HOME)", java)
+	}
+	gofrontend = os.Getenv("GRAALGO_GOFRONTEND")
+	if gofrontend == "" {
+		gofrontend = os.Getenv("GRAALGO_TEST_GOFRONTEND")
+	}
+	if gofrontend == "" {
+		for _, cand := range []string{
+			filepath.Join(root, "internal", "frontend", "gofrontend"),
+			filepath.Join(root, "phases", "phase1", "frontend", "gofrontend"),
+		} {
+			if fi, err := os.Stat(cand); err == nil && fi.Mode()&0o111 != 0 {
+				gofrontend = cand
+				break
+			}
+		}
+	}
+	if gofrontend == "" {
+		t.Skip("gofrontend not found (set GRAALGO_GOFRONTEND or run make generate)")
+	}
+	if fi, err := os.Stat(gofrontend); err != nil || fi.Mode()&0o111 == 0 {
+		t.Skipf("gofrontend not executable: %s", gofrontend)
+	}
+	return root, gofrontend
+}
